# Permite que cloudflare/wrangler-action@v3 instale wrangler en la raiz del
# monorepo sin pasar el flag -w. Sin esto, `pnpm add wrangler` (que ejecuta la
# action cuando no encuentra wrangler en el runner) aborta con ERR_PNPM_ADDING_TO_ROOT
# y el deploy del widget cima-chat falla.
ignore-workspace-root-check=true
