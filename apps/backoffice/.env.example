# Backoffice envs — Fase 1.B
# Copia a .env.local y rellena.
#
# ⚠️  AUTH_SECRET y DATABASE_URL DEBEN coincidir con las del conciliador
# para que la sesión sea compatible entre ambas apps.

# Auth
AUTH_SECRET=""            # openssl rand -base64 32 · MISMO que conciliador
AUTH_URL="http://localhost:3001"

# Neon (misma BD que conciliador)
DATABASE_URL=""           # pooler URL
DIRECT_DATABASE_URL=""    # direct URL (para prisma migrate; el backoffice NO corre migraciones)

# URL del conciliador standalone (botón "Nueva conciliación" del dashboard).
# En dev: http://localhost:3000 · en prod: https://conciliador.larokifarm.com
CONCILIADOR_STANDALONE_URL=""

# URL del scout standalone (botón "Abrir scout" del dashboard).
# En dev: http://localhost:3002 · en prod: https://scout.larokifarm.com
SCOUT_STANDALONE_URL=""

# Contenido de farmacias desde Neon (false = mock en memoria)
USE_NEON_CONTENT=true

# Storage de imágenes: "local" (./storage) en dev · "r2" en prod
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
R2_ENDPOINT=""            # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# URL pública del backoffice (tu dominio personalizado, sin "/" final).
# Con ella se construyen las URLs absolutas de imágenes y avatares que
# devuelve la API pública (/api/public/*) y que quedan en el HTML de las
# landings. Vacía = origen de la petición (vale en local).
# En prod: https://backoffice.tudominio.com
BACKOFFICE_PUBLIC_URL=""
