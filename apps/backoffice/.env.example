# Backoffice envs — Fase 1.B
# Copia a .env.local y rellena.
#
# ⚠️  AUTH_SECRET y DATABASE_URL DEBEN coincidir con las del conciliador
# para que la sesión sea compatible entre ambas apps.

# Auth
AUTH_SECRET=""            # openssl rand -base64 32 · MISMO que conciliador
AUTH_URL="http://localhost:3001"

# Neon (misma BD que conciliador)
DATABASE_URL=""           # pooler URL
DIRECT_DATABASE_URL=""    # direct URL (para prisma migrate; el backoffice NO corre migraciones)

# Módulos externos (Fase 1.C/D)
CONCILIADOR_WORKER_URL=""
CONCILIADOR_WORKER_TOKEN=""
SCOUT_WORKER_URL=""
SCOUT_WORKER_TOKEN=""

# URL del conciliador standalone (Fase 1.C.1 · botón "Nueva conciliación")
# En dev: http://localhost:3000 · en prod: https://conciliador.larokifarm.com
CONCILIADOR_STANDALONE_URL=""
