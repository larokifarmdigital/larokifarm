---
import LegalPage from '@/components/LegalPage.astro';
import {
  obtenerFarmaciaPorSlug,
  localizar,
  portableTextAHtml,
  SLUG_FARMACIA,
  type Farmacia,
} from '@/lib/contenido';
import { esLocaleValido, type Locale } from '@/lib/i18n';
import { legalPorDefecto } from '@/lib/legal';

export async function getStaticPaths() {
  const farmacia = await obtenerFarmaciaPorSlug(SLUG_FARMACIA);
  const codigos = (farmacia?.idiomasActivos ?? [{ codigo: 'es', nombre: 'Español' }])
    .map((i) => i.codigo)
    .filter(esLocaleValido);
  const lista = codigos.length > 0 ? codigos : (['es'] as Locale[]);
  return lista.map((c) => ({
    params: { lang: c === 'es' ? undefined : c },
    props: { farmacia, lang: c },
  }));
}

interface Props { farmacia: Farmacia | null; lang: Locale; }
const { farmacia: farmaciaCargada, lang } = Astro.props as Props;

const farmacia: Farmacia = farmaciaCargada ?? {
  _id: 'placeholder',
  nombre: 'Farmacia Chamarro',
  slug: SLUG_FARMACIA,
};

const html =
  portableTextAHtml(localizar(farmacia.avisoLegal, lang)) || legalPorDefecto(lang).avisoLegal;
---

<LegalPage farmacia={farmacia} lang={lang} tipo='aviso' html={html} />
