---
import '@/styles/global.css';
import { LOCALE_DEFECTO, OG_LOCALE, rutaConLocale, type Locale } from '@/lib/i18n';
import { urlImagen } from '@/lib/contenido';
import { CHAT } from '@/lib/chat';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  titulo: string;
  descripcion?: string;
  canonical: string;
  imagenOg?: string;
  jsonLd?: unknown;
  lang: Locale;
  idiomas?: Locale[];
  rutaActual?: string;
  nombreFarmacia?: string;
  logoFarmacia?: string;
}

const {
  titulo,
  descripcion,
  canonical,
  imagenOg,
  jsonLd,
  lang,
  idiomas,
  rutaActual = '/',
  nombreFarmacia,
  logoFarmacia
} = Astro.props;

const logoChatUrl = urlImagen(logoFarmacia, { w: 128, h: 128, fit: 'crop' });

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImageAbsoluta = imagenOg?.startsWith('http')
  ? imagenOg
  : imagenOg
    ? `${siteUrl}${imagenOg}`
    : undefined;

const OG_LOCALES = OG_LOCALE;
const idiomasWeb: Locale[] = idiomas?.length ? idiomas : [...new Set<Locale>([LOCALE_DEFECTO, lang])];

const hreflangs = idiomasWeb.map(codigo => ({
  hreflang: codigo,
  href: `${siteUrl}${rutaConLocale(rutaActual, codigo)}`.replace(/\/$/, '') || `${siteUrl}/`
}));
const hrefDefault =
  `${siteUrl}${rutaConLocale(rutaActual, LOCALE_DEFECTO)}`.replace(/\/$/, '') || `${siteUrl}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='generator' content={Astro.generator} />

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link rel='preconnect' href='https://www.google.com' />
    <link rel='dns-prefetch' href='https://larokifarm-cima-chat-5f3.pages.dev' />
    <link rel='dns-prefetch' href='https://cima-chat-llm.larokifarmdigital.workers.dev' />
    <link rel='dns-prefetch' href='https://larokifarm-cima-chat-5f3.pages.dev' />

    <link
      rel='stylesheet'
      href='https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap'
    />

    <title>{titulo}</title>
    {descripcion && <meta name='description' content={descripcion} />}
    <link rel='canonical' href={canonical} />

    {hreflangs.map(h => <link rel='alternate' hreflang={h.hreflang} href={h.href} />)}
    <link rel='alternate' hreflang='x-default' href={hrefDefault} />

    <meta name='robots' content='index,follow,max-snippet:-1,max-image-preview:large' />

    <meta property='og:type' content='website' />
    <meta property='og:locale' content={OG_LOCALES[lang]} />
    {
      idiomasWeb.filter(l => l !== lang).map(l => (
        <meta property='og:locale:alternate' content={OG_LOCALES[l]} />
      ))
    }
    <meta property='og:title' content={titulo} />
    {descripcion && <meta property='og:description' content={descripcion} />}
    <meta property='og:url' content={canonical} />
    {ogImageAbsoluta && <meta property='og:image' content={ogImageAbsoluta} />}

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={titulo} />
    {descripcion && <meta name='twitter:description' content={descripcion} />}
    {ogImageAbsoluta && <meta name='twitter:image' content={ogImageAbsoluta} />}

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32.png' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <link rel='manifest' href='/manifest.webmanifest' />
    <meta name='theme-color' content='#0f6b3c' />

    {
      jsonLd && (
        <script is:inline type='application/ld+json' set:html={JSON.stringify(jsonLd, null, 0).replace(/</g, '\\u003c')} />
      )
    }

    <slot name='head' />
  </head>
  <body>
    <a
      href='#contenido'
      class='sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-[2px] focus:bg-[var(--foreground)] focus:px-4 focus:py-2 focus:font-medium focus:text-white focus:outline-none'
    >
      Saltar al contenido
    </a>
    <slot />

    <Analytics />

    <script>
      import { track } from '@vercel/analytics';
      document.addEventListener('click', e => {
        const enlace = (e.target as Element | null)?.closest('a');
        if (!enlace) return;
        const href = enlace.getAttribute('href') ?? '';
        if (href.startsWith('tel:')) track('llamar');
        else if (href.includes('wa.me') || href.includes('whatsapp')) track('whatsapp');
      });
    </script>

    <script>
      const observed = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (observed.length > 0 && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -80px 0px' }
        );
        observed.forEach(el => io.observe(el));
      } else {
        observed.forEach(el => el.classList.add('in-view'));
      }

      /* Solo con puntero fino: en táctil no hay cursor que seguir. */
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (finePointer) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach(el => {
          el.classList.add('spotlight');
          el.addEventListener('pointermove', e => {
            const rect = el.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            el.style.setProperty('--mx', `${x}%`);
            el.style.setProperty('--my', `${y}%`);
          });
        });
      }

      /* data-count-up="N" anima el textContent de 0 a N; duración en ms con data-count-duration. */
      const counters = document.querySelectorAll<HTMLElement>('[data-count-up]');
      if (counters.length > 0 && 'IntersectionObserver' in window) {
        const preferSinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const cio = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const target = parseFloat(el.dataset.countUp ?? '0');
              const duration = parseInt(el.dataset.countDuration ?? '1200', 10);
              const suffix = el.dataset.countSuffix ?? '';
              cio.unobserve(el);
              if (preferSinMovimiento) {
                el.textContent = `${target}${suffix}`;
                continue;
              }
              const start = performance.now();
              function tick(now: number) {
                const t = Math.min(1, (now - start) / duration);
                const eased = 1 - Math.pow(1 - t, 3);
                const current = Math.round(target * eased);
                el.textContent = `${current}${suffix}`;
                if (t < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
            }
          },
          { threshold: 0.5 }
        );
        counters.forEach(el => cio.observe(el));
      }
    </script>

    {CHAT.activo && (
      <Fragment>
        <div
          data-cima-chat
          data-theme='light'
          data-primary-light={CHAT.color}
          data-primary-dark='#6dc261'
          data-position={CHAT.posicion === 'izquierda' ? 'bottom-left' : 'bottom-right'}
          data-logo-url={CHAT.mostrarLogo ? logoChatUrl : undefined}
          data-brand-name={CHAT.nombre ?? nombreFarmacia}
          data-inventory={CHAT.mostrarDisponible ? undefined : 'off'}
        >
        </div>
        <script is:inline async src='https://larokifarm-cima-chat-5f3.pages.dev/cima-chat.iife.js'>
        </script>
      </Fragment>
    )}
  </body>
</html>
