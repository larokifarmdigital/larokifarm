---
import {
  localizar,
  portableTextAHtml,
  type ImagenConAlt,
  type LocalizedString,
  type LocalizedPortableText,
} from '@/lib/sanity';
import { t, tArray, type Locale } from '@/lib/i18n';

interface Props {
  imagenes?: ImagenConAlt[];
  titulo?: LocalizedString;
  descripcionLarga?: LocalizedPortableText;
  puntos?: LocalizedString[];
  anyosExperiencia?: number;
  chip?: LocalizedString;
  lang: Locale;
}

const { imagenes, titulo, descripcionLarga, puntos, anyosExperiencia, chip, lang } = Astro.props;

const listaImagenes = (imagenes ?? []).filter((i) => i?.url).slice(0, 6);
const tieneCarrusel = listaImagenes.length > 1;
const chipTexto = localizar(chip, lang) || t('about.chip', lang);
const tituloTexto = localizar(titulo, lang) || t('about.tituloDefecto', lang);
const cuerpoHtml = portableTextAHtml(localizar(descripcionLarga, lang));

const puntosResueltos = (() => {
  const lista = (puntos ?? [])
    .map((p) => localizar(p, lang))
    .filter((s): s is string => Boolean(s?.trim()));
  return lista.length > 0 ? lista : tArray('about.puntosDefecto', lang);
})();
---

<section
  id='sobre'
  class='py-[clamp(6rem,10vw,9rem)] bg-[color:var(--background)]'
>
  <div class='container-app grid grid-cols-1 min-[900px]:grid-cols-[1fr_1.15fr] gap-[clamp(2.5rem,5vw,5rem)] items-center'>
    <div class='about-slider relative motion-float' data-about-slider={tieneCarrusel ? 'true' : undefined} data-reveal>
      <div class='about-frame aspect-[4/5] relative overflow-hidden rounded-[var(--radius-xl)] bg-[color:var(--surface)] border border-[color:var(--border)]'
           style='box-shadow: var(--shadow-lift);'>
        {listaImagenes.length > 0 ? (
          listaImagenes.map((img, i) => (
            <img
              src={img.url}
              alt={i === 0 ? (localizar(img.alt, lang) || tituloTexto) : ''}
              loading={i === 0 ? 'eager' : 'lazy'}
              class={`about-slide absolute inset-0 w-full h-full object-cover block ${i === 0 ? 'is-active' : ''}`}
              data-idx={String(i)}
            />
          ))
        ) : (
          <div class='absolute inset-0' aria-hidden='true'></div>
        )}
      </div>

      {/* Badge años · con count-up animation al entrar en viewport */}
      {anyosExperiencia && (
        <div class='about-badge absolute -bottom-6 -left-5 z-10 inline-flex items-center gap-3 bg-[color:var(--card)] px-4 py-3 border border-[color:var(--border)] rounded-[var(--radius-lg)]'
             style='box-shadow: var(--shadow-lift);'>
          <div class='flex flex-col leading-tight'>
            <span class='text-[1.75rem] leading-none tabular-nums text-[color:var(--foreground-strong)] tracking-[-0.03em] shrink-0'
                  style='font-family: var(--font-serif); font-weight: 400;'
                  data-count-up={anyosExperiencia}
                  data-count-suffix='+'
                  data-count-duration='1400'>0+</span>
            <span class='text-[0.68rem] font-medium tracking-[0.12em] uppercase text-[color:var(--muted)] mt-1 leading-tight whitespace-nowrap'
                  style='font-family: var(--font-mono);'>
              {t('about.badge.anyos', lang)} {t('about.badge.experiencia', lang)}
            </span>
          </div>
        </div>
      )}

      {tieneCarrusel && (
        <div
          class='absolute bottom-4 right-4 inline-flex gap-2 z-10 rounded-full bg-black/30 backdrop-blur-md px-3 py-2'
          role='tablist'
          aria-label='Cambiar imagen'
        >
          {listaImagenes.map((_, i) => (
            <button
              type='button'
              class={`about-dot h-2 rounded-full bg-white/40 border-none cursor-pointer transition-all duration-300 ${i === 0 ? 'is-active' : ''}`}
              data-about-dot={String(i)}
              aria-label={`Imagen ${i + 1} de ${listaImagenes.length}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              role='tab'
            ></button>
          ))}
        </div>
      )}
    </div>

    <div class='flex flex-col gap-6'>
      <span class='section-eyebrow self-start' data-reveal>{chipTexto}</span>
      <h2 class='h-section m-0 max-w-[18ch]' style='--reveal-delay:100ms' data-reveal>{tituloTexto}</h2>

      {cuerpoHtml ? (
        <div class='about-corp__cuerpo text-[color:var(--muted-foreground)] leading-[1.75] text-[1.02rem] max-w-[52ch]'
             style='--reveal-delay:200ms'
             data-reveal
             set:html={cuerpoHtml} />
      ) : (
        <p class='text-[color:var(--muted-foreground)] leading-[1.75] text-[1.02rem] max-w-[52ch]'
           style='--reveal-delay:200ms'
           data-reveal>{t('about.cuerpoFallback', lang)}</p>
      )}

      {puntosResueltos.length > 0 && (
        <ul class='list-none p-0 mt-2 grid grid-cols-1 min-[500px]:grid-cols-2 gap-3 min-[500px]:gap-x-6'>
          {puntosResueltos.map((p, i) => (
            <li class='inline-flex items-start gap-2.5 text-[0.9rem] text-[color:var(--foreground)] leading-[1.5]'
                style={`--reveal-delay:${300 + i * 60}ms`}
                data-reveal>
              <span
                class='inline-flex items-center justify-center w-5 h-5 bg-[color:var(--foreground-strong)] text-[color:var(--background)] rounded-full shrink-0 mt-[1px]'
                aria-hidden='true'
              >
                <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'>
                  <path d='M20 6 9 17l-5-5' />
                </svg>
              </span>
              {p}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  /* CMS content injected via set:html — necesita selectores :global() para alcanzar los
     <p> y <strong> que vienen del portable text. Tailwind no puede tocarlos inline. */
  .about-corp__cuerpo :global(p) { margin: 0 0 1rem; }
  .about-corp__cuerpo :global(p:last-child) { margin-bottom: 0; }
  .about-corp__cuerpo :global(strong) { color: var(--foreground); font-weight: 600; }

  /* Slider — cross-fade editorial 900ms. */
  .about-slide {
    opacity: 0;
    transition: opacity 900ms var(--ease-in-out);
  }
  .about-slide.is-active { opacity: 1; }

  .about-dot {
    width: 6px;
    transition:
      width var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .about-dot.is-active {
    background: rgb(255 255 255 / 0.95);
    width: 20px;
  }
  @media (hover: hover) and (pointer: fine) {
    .about-dot:hover { background: rgb(255 255 255 / 0.75); }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-slide { transition: none; }
  }
</style>

<script>
  /* Slider About — cross-fade automático cada 6s. Pausa al cambiar de pestaña.
     Respeta prefers-reduced-motion. */
  const slider = document.querySelector<HTMLElement>('[data-about-slider]');
  if (slider) {
    const slides = Array.from(slider.querySelectorAll<HTMLImageElement>('.about-slide'));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-about-dot]'));
    if (slides.length > 1) {
      let indice = 0;
      let timerId: number | undefined;
      const INTERVALO = 6000;

      function mostrar(i: number) {
        indice = ((i % slides.length) + slides.length) % slides.length;
        slides.forEach((s, idx) => s.classList.toggle('is-active', idx === indice));
        dots.forEach((d, idx) => {
          const activo = idx === indice;
          d.classList.toggle('is-active', activo);
          d.setAttribute('aria-selected', activo ? 'true' : 'false');
        });
      }

      function siguiente() { mostrar(indice + 1); }

      function iniciar() {
        detener();
        timerId = window.setInterval(siguiente, INTERVALO);
      }
      function detener() {
        if (timerId !== undefined) {
          window.clearInterval(timerId);
          timerId = undefined;
        }
      }

      dots.forEach((d, i) => {
        d.addEventListener('click', () => {
          mostrar(i);
          iniciar();
        });
      });

      const preferSinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!preferSinMovimiento) {
        iniciar();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) detener();
          else iniciar();
        });
      }
    }
  }
</script>
