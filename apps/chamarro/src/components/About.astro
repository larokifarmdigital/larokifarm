---
import {
  localizar,
  portableTextAHtml,
  type ImagenConAlt,
  type LocalizedString,
  type LocalizedPortableText,
} from '@/lib/contenido';
import { t, tArray, type Locale } from '@/lib/i18n';
import FotoMarco from '@/components/FotoMarco.astro';

interface Props {
  imagenes?: ImagenConAlt[];
  titulo?: LocalizedString;
  descripcionLarga?: LocalizedPortableText;
  puntos?: LocalizedString[];
  anyosExperiencia?: number;
  chip?: LocalizedString;
  lang: Locale;
}

const { imagenes, titulo, descripcionLarga, puntos, anyosExperiencia, chip, lang } = Astro.props;

const listaImagenes = (imagenes ?? []).filter((i) => i?.url).slice(0, 6);
// La 1ª foto suele ser la misma que abre la portada: aquí empezamos por la
// última para no repetirla.
const principal = listaImagenes[listaImagenes.length - 1];
const secundaria = listaImagenes.length > 2 ? listaImagenes[1] : undefined;
const chipTexto = localizar(chip, lang) || t('about.chip', lang);
const tituloTexto = localizar(titulo, lang) || t('about.tituloDefecto', lang);
const cuerpoHtml = portableTextAHtml(localizar(descripcionLarga, lang));

const puntosResueltos = (() => {
  const lista = (puntos ?? [])
    .map((p) => localizar(p, lang))
    .filter((s): s is string => Boolean(s?.trim()));
  return lista.length > 0 ? lista : tArray('about.puntosDefecto', lang);
})();
---

<section id='sobre' class='py-[clamp(4rem,7vw,6rem)]'>
  <div class='container-app about-grid'>
    <div class='tile about-foto !p-0' data-reveal>
      {principal ? (
        <FotoMarco url={principal.url} alt={localizar(principal.alt, lang) || tituloTexto} ancho={1000} />
      ) : (
        <div class='absolute inset-0 bg-[color:var(--canvas-alt)]' aria-hidden='true'></div>
      )}
    </div>

    <div class='about-lateral'>
      {anyosExperiencia && (
        <div class='tile tile-green about-stat' data-reveal style='--reveal-delay:80ms'>
          <span class='about-stat-num tabular-nums' data-count-up={anyosExperiencia} data-count-suffix='+' data-count-duration='1400'>{anyosExperiencia}+</span>
          <span class='about-stat-txt'>{t('about.badge.anyos', lang)} {t('about.badge.experiencia', lang)}</span>
        </div>
      )}
      {secundaria && (
        <div class='tile about-foto-mini !p-0' data-reveal style='--reveal-delay:140ms' aria-hidden='true'>
          <FotoMarco url={secundaria.url} alt='' ancho={600} />
        </div>
      )}
    </div>

    <div class='about-texto flex flex-col gap-5 min-w-0'>
      <span class='section-eyebrow' data-reveal>{chipTexto}</span>
      <h2 class='h-section m-0 max-w-[18ch]' style='--reveal-delay:100ms' data-reveal>{tituloTexto}</h2>
      {cuerpoHtml ? (
        <div class='about-cuerpo text-[color:var(--muted-foreground)] leading-[1.75] text-[1.02rem] max-w-[60ch]' style='--reveal-delay:180ms' data-reveal set:html={cuerpoHtml} />
      ) : (
        <p class='text-[color:var(--muted-foreground)] leading-[1.75] text-[1.02rem] max-w-[60ch]' style='--reveal-delay:180ms' data-reveal>{t('about.cuerpoFallback', lang)}</p>
      )}
      {puntosResueltos.length > 0 && (
        <ul class='list-none p-0 m-0 mt-2 grid grid-cols-1 min-[500px]:grid-cols-2 gap-x-6 gap-y-3'>
          {puntosResueltos.map((p, i) => (
            <li class='about-punto' style={`--reveal-delay:${260 + i * 50}ms`} data-reveal>
              <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M20 6 9 17l-5-5' /></svg>
              {p}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: clamp(0.75rem, 1.4vw, 1rem);
    grid-template-columns: 1fr;
  }
  .about-foto { aspect-ratio: 4 / 3; }
  .about-lateral { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 1.4vw, 1rem); }
  .about-texto { padding: clamp(1.5rem, 3vw, 2.5rem) clamp(0.25rem, 1vw, 0.5rem) 0; }
  @media (min-width: 960px) {
    .about-grid { grid-template-columns: 1.05fr 0.45fr 1.3fr; align-items: stretch; }
    .about-foto { aspect-ratio: auto; min-height: 520px; }
    .about-lateral { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .about-texto { padding: clamp(1rem, 2vw, 1.5rem) 0 clamp(1rem, 2vw, 1.5rem) clamp(1rem, 3vw, 2.5rem); justify-content: center; }
  }
  .about-foto-mini { min-height: 160px; }

  .about-stat { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.4rem; min-height: 160px; }
  .about-stat-num { font-size: clamp(3rem, 3vw + 1.8rem, 4.2rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.95; color: var(--brand-lime); }
  .about-stat-txt { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-green-muted); }

  .about-cuerpo :global(p) { margin: 0 0 1rem; }
  .about-cuerpo :global(p:last-child) { margin-bottom: 0; }
  .about-cuerpo :global(strong) { color: var(--foreground-strong); font-weight: 700; }
  .about-cuerpo :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }

  /* Lista con check (antes eran píldoras y parecían botones) */
  .about-punto {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground-strong);
  }
  .about-punto svg {
    flex: none;
    width: 22px;
    height: 22px;
    padding: 4px;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary);
  }
</style>
