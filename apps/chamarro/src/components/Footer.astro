---
import { rutaConLocale, t, type Locale } from '@/lib/i18n';
import { MOSTRAR_RESENAS } from '@/lib/feature-flags';
import type { Contacto, Direccion, RedesSociales } from '@/lib/sanity';

interface Props {
  nombre: string;
  titular?: string;
  numeroColegiado?: string;
  logo?: string;
  contacto?: Contacto;
  redes?: RedesSociales;
  direccion?: Direccion;
  mostrarFaqs?: boolean;
  lang: Locale;
  rutaActual: string;
}

const {
  nombre,
  titular,
  numeroColegiado,
  logo,
  contacto,
  redes,
  direccion,
  mostrarFaqs = true,
  lang,
} = Astro.props;

const logoUrl = logo || '/logo.png';
const anyo = new Date().getFullYear();
const home = rutaConLocale('/', lang);

const lineasDireccion = [
  direccion?.calle,
  direccion?.codigoPostal && direccion?.ciudad
    ? `${direccion.codigoPostal} ${direccion.ciudad}`
    : direccion?.ciudad,
  direccion?.provincia,
].filter((s): s is string => Boolean(s?.trim()));

const tieneRedes = redes && (redes.instagram || redes.facebook || redes.tiktok);

const grupos = [
  {
    label: t('footer.informacion', lang),
    links: [
      { href: `${home}#servicios`, label: t('footer.servicios', lang) },
      { href: `${home}#sobre`, label: t('footer.sobreNosotros', lang) },
      mostrarFaqs ? { href: `${home}#faqs`, label: t('footer.preguntasFrecuentes', lang) } : null,
      MOSTRAR_RESENAS ? { href: rutaConLocale('/resenas', lang), label: t('footer.resenas', lang) } : null,
    ].filter((e): e is { href: string; label: string } => e !== null),
  },
  {
    label: t('footer.contactanos', lang),
    links: [
      contacto?.telefono ? { href: `tel:${contacto.telefono.replace(/\s+/g, '')}`, label: contacto.telefono, mono: true } : null,
      contacto?.email ? { href: `mailto:${contacto.email}`, label: contacto.email } : null,
      contacto?.web ? {
        href: contacto.web,
        label: contacto.web.replace(/^https?:\/\//, '').replace(/\/$/, ''),
        external: true,
      } : null,
    ].filter(<T,>(e: T | null): e is T => e !== null),
  },
  {
    label: 'Legal',
    links: [
      { href: rutaConLocale('/aviso-legal', lang), label: t('footer.avisoLegal', lang) },
      { href: rutaConLocale('/politica-privacidad', lang), label: t('footer.politicaPrivacidad', lang) },
    ],
  },
];
---

<footer class='footer relative bg-[color:var(--canvas-alt)] border-t border-[color:var(--border)]'>
  <div class='container-app pt-[clamp(4rem,7vw,6rem)] pb-8'>

    {/* CTA hero superior con serif italic y underline animation */}
    <div class='footer-cta flex flex-col min-[720px]:flex-row min-[720px]:items-end min-[720px]:justify-between gap-8 pb-[clamp(3rem,5vw,4rem)] border-b border-[color:var(--border)]'
         data-reveal>
      <div class='flex flex-col gap-4 max-w-[36ch]'>
        <span class='inline-flex items-center gap-2 text-[color:var(--muted)] text-[0.7rem] tracking-[0.06em]'
              style='font-family: var(--font-mono);'>
          <span class='w-1.5 h-1.5 rounded-full bg-[color:var(--success)] motion-pulse'></span>
          {t('footer.badgeColegiada', lang)}
        </span>
        <h2 class='m-0'
            style='font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); letter-spacing: -0.03em; line-height: 1.08; color: var(--foreground-strong);'>
          ¿Necesitas ayuda? <em>Estamos aquí</em>.
        </h2>
      </div>
      <div class='inline-flex gap-2.5 flex-wrap'>
        {contacto?.telefono && (
          <a href={`tel:${contacto.telefono.replace(/\s+/g, '')}`} class='btn btn-primary'>
            <svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
              <path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z' />
            </svg>
            <span class='tabular-nums'>{contacto.telefono}</span>
          </a>
        )}
        {contacto?.whatsapp && (
          <a href={`https://wa.me/${contacto.whatsapp.replace(/[^0-9]/g, '')}`}
             target='_blank'
             rel='noopener noreferrer'
             class='btn btn-secondary'>
            <svg width='14' height='14' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'>
              <path d='M20.5 3.5A11 11 0 0 0 3.4 17l-1.4 5 5.1-1.3A11 11 0 1 0 20.5 3.5zM12 20a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.5-5.9c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1c-.2.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.2a.4.4 0 0 0 0-.4c0-.1-.6-1.4-.8-1.9s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.3 5.4 5.4 0 0 0 1.1 2.9c.1.2 2 3 4.8 4.2a15.9 15.9 0 0 0 1.6.6 3.9 3.9 0 0 0 1.7.1c.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.4-.3z' />
            </svg>
            WhatsApp
          </a>
        )}
      </div>
    </div>

    {/* GRID · brand + 3 columnas con stagger reveal */}
    <div class='grid grid-cols-1 min-[720px]:grid-cols-[1.4fr_1fr_1fr_1fr] gap-x-10 gap-y-10 pt-[clamp(3rem,5vw,4rem)]'>

      <div class='footer-col flex flex-col gap-5' data-reveal>
        <a href={home} class='inline-flex items-center gap-2.5 no-underline text-[color:var(--foreground-strong)]' aria-label={nombre}>
          <img
            src={logoUrl}
            alt={nombre}
            class='block w-9 h-9 object-contain'
            width='72'
            height='72'
            loading='lazy'
          />
          <span class='font-medium text-[1rem] tracking-[-0.015em] leading-tight'>{nombre}</span>
        </a>

        {lineasDireccion.length > 0 && (
          <address class='not-italic flex flex-col gap-0.5 text-[color:var(--muted)] text-[0.85rem] leading-[1.55]'>
            {lineasDireccion.map((l) => <span>{l}</span>)}
          </address>
        )}

        {tieneRedes && (
          <div class='footer-redes inline-flex gap-2 mt-1'>
            {redes.instagram && (
              <a href={redes.instagram} target='_blank' rel='noopener noreferrer'
                 aria-label={t('footer.ariaInstagram', lang)}
                 class='footer-social inline-flex items-center justify-center w-9 h-9 text-[color:var(--muted)] border border-[color:var(--border)] bg-[color:var(--card)]'
                 style='border-radius: var(--radius-xs);'>
                <svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                  <rect x='2' y='2' width='20' height='20' rx='5' />
                  <path d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z' />
                  <line x1='17.5' y1='6.5' x2='17.51' y2='6.5' />
                </svg>
              </a>
            )}
            {redes.facebook && (
              <a href={redes.facebook} target='_blank' rel='noopener noreferrer'
                 aria-label={t('footer.ariaFacebook', lang)}
                 class='footer-social inline-flex items-center justify-center w-9 h-9 text-[color:var(--muted)] border border-[color:var(--border)] bg-[color:var(--card)]'
                 style='border-radius: var(--radius-xs);'>
                <svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                  <path d='M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' />
                </svg>
              </a>
            )}
            {redes.tiktok && (
              <a href={redes.tiktok} target='_blank' rel='noopener noreferrer'
                 aria-label={t('footer.ariaTiktok', lang)}
                 class='footer-social inline-flex items-center justify-center w-9 h-9 text-[color:var(--muted)] border border-[color:var(--border)] bg-[color:var(--card)]'
                 style='border-radius: var(--radius-xs);'>
                <svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                  <path d='M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5' />
                </svg>
              </a>
            )}
          </div>
        )}
      </div>

      {grupos.map((g, gi) => (
        <div class='footer-col flex flex-col gap-4' style={`--reveal-delay:${(gi + 1) * 100}ms`} data-reveal>
          <h3 class='m-0 text-[color:var(--muted)] text-[0.72rem] font-normal tracking-[0.06em]'
              style='font-family: var(--font-mono);'>
            {g.label}
          </h3>
          <ul class='list-none p-0 m-0 flex flex-col gap-2.5'>
            {g.links.map((l: any) => (
              <li>
                <a href={l.href}
                   {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                   class={`footer-link link-anim inline-block text-[color:var(--foreground)] no-underline text-[0.9rem] ${l.mono ? 'tabular-nums' : ''}`}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* BOTTOM BAR */}
    <div class='pt-8 mt-[clamp(3rem,5vw,4rem)] border-t border-[color:var(--border)] flex flex-col-reverse min-[720px]:flex-row min-[720px]:items-center min-[720px]:justify-between gap-4'>
      <p class='m-0 text-[color:var(--muted)] text-[0.78rem]'>
        {t('footer.copyright', lang, { anyo, nombre })}
      </p>

      {(titular || numeroColegiado) && (
        <div class='flex flex-col min-[720px]:text-right text-[color:var(--muted)] text-[0.72rem] leading-[1.5]'>
          {titular && <span>{titular}</span>}
          {numeroColegiado && (
            <span class='tabular-nums' style='font-family: var(--font-mono);'>
              {t('footer.nCol', lang)} {numeroColegiado}
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</footer>

<style>
  /* Hover en redes: bordes se rellenan + lift con magnetic */
  @media (hover: hover) and (pointer: fine) {
    .footer-social {
      transition:
        color var(--dur-fast) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out),
        transform var(--dur) var(--ease-magnetic);
    }
    .footer-social:hover {
      color: var(--background);
      background: var(--foreground-strong);
      border-color: var(--foreground-strong);
      transform: translateY(-2px);
    }
    .footer-link:hover { color: var(--foreground-strong); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social:hover { transform: none; }
  }
</style>
