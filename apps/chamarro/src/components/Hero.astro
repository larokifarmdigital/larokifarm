---
import { horariosParaEstado, textosEstado } from '@/lib/estadoHorarioDatos';
import { localizar, type HorarioDia, type ImagenConAlt, type LocalizedString, type TarjetaFlotante } from '@/lib/sanity';
import { t, type Locale } from '@/lib/i18n';
import IconoServicio from '@/components/IconoServicio.astro';
import FotoMarco from '@/components/FotoMarco.astro';

interface Props {
  nombre: string;
  ciudad?: string;
  imagenes?: ImagenConAlt[];
  telefono?: string;
  chip?: LocalizedString;
  titulo?: LocalizedString;
  claim?: string;
  tarjetasFlotantes?: TarjetaFlotante[];
  horarios?: HorarioDia[];
  lang: Locale;
}

const { nombre, ciudad, imagenes, telefono, chip, titulo, claim, tarjetasFlotantes, horarios, lang } = Astro.props;

const listaImagenes = (imagenes ?? []).filter((i) => i?.url).slice(0, 6);
const tieneCarrusel = listaImagenes.length > 1;

const chipTexto =
  localizar(chip, lang) ||
  (ciudad ? t('hero.chip.conCiudad', lang, { ciudad }) : t('hero.chip.sinCiudad', lang));

const tituloTexto = localizar(titulo, lang) || t('hero.tituloDefecto', lang);
const palabrasTitulo = tituloTexto.split(/\s+/).filter(Boolean);
const retrasoFinal = 120 + palabrasTitulo.length * 60;

const tarjetasBackoffice = (tarjetasFlotantes ?? [])
  .map((tj) => ({ icono: tj.icono, titulo: localizar(tj.titulo, lang), subtitulo: localizar(tj.subtitulo, lang) }))
  .filter((tj) => Boolean(tj.titulo));
const tarjetasDefault = [
  { icono: 'shield', titulo: t('hero.trust.colegiados', lang), subtitulo: t('hero.trust.colegiadosSub', lang) },
  { icono: 'clock', titulo: t('hero.trust.horario', lang), subtitulo: t('hero.trust.horarioSub', lang) },
  { icono: 'heart-pulse', titulo: t('hero.trust.consejo', lang), subtitulo: t('hero.trust.consejoSub', lang) },
];
const tarjetas = tarjetasBackoffice.length > 0 ? tarjetasBackoffice : tarjetasDefault;

/* Estado "abierto/cerrado" real: se calcula en el navegador con la hora de
   Madrid (la web es estática). Sin horarios la tarjeta no se muestra. */
const horariosLimpios = horariosParaEstado(horarios);
const textosEstadoJson = JSON.stringify(textosEstado(lang));
---

<section class='hero' aria-label={t('hero.altInterior', lang, { nombre })}>
  <div class='container-app pt-[clamp(1rem,2.5vw,1.75rem)] pb-[clamp(2.5rem,5vw,4rem)]'>
    <div class='hero-grid'>

      <!-- Bloque verde con el titular -->
      <div class='tile tile-green hero-main'>
        <div class='hero-main-glow' aria-hidden='true'></div>
        <div class='relative flex flex-col gap-[clamp(1.25rem,2.2vw,1.75rem)] h-full'>
          <span class='section-eyebrow' data-reveal>{chipTexto}</span>

          <h1 class='h-display m-0 max-w-[13ch]'>
            {palabrasTitulo.map((palabra, i) => (
              <>
                <span style={`--reveal-delay:${120 + i * 60}ms`} data-reveal-word>{palabra}</span>
                {i < palabrasTitulo.length - 1 && ' '}
              </>
            ))}
          </h1>

          {claim && (
            <p class='m-0 max-w-[50ch] text-[clamp(1rem,0.5vw+0.85rem,1.12rem)] leading-[1.65] text-[color:var(--on-green-muted)]'
               style={`--reveal-delay:${retrasoFinal + 60}ms`} data-reveal>
              {claim}
            </p>
          )}

          <div class='flex flex-wrap gap-3' style={`--reveal-delay:${retrasoFinal + 140}ms`} data-reveal>
            <a href='#servicios' class='btn btn-light'>
              {t('hero.btnServicios', lang)}
              <span class='btn-icon-nested' aria-hidden='true'>
                <svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M13 6l6 6-6 6' /></svg>
              </span>
            </a>
            {telefono && (
              <a href={`tel:${telefono.replace(/\s+/g, '')}`} class='btn btn-outline-light'>
                <svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z' /></svg>
                {t('hero.btnLlamar', lang)}
              </a>
            )}
          </div>

          {tarjetas.length > 0 && (
            <ul class='hero-trust list-none p-0 m-0 mt-auto grid grid-cols-1 min-[620px]:grid-cols-3 gap-3'>
              {tarjetas.map((tj, idx) => (
                <li class='hero-trust-item' style={`--reveal-delay:${retrasoFinal + 220 + idx * 70}ms`} data-reveal>
                  <span class='hero-trust-icon' aria-hidden='true'><IconoServicio nombre={tj.icono ?? 'shield'} size={17} /></span>
                  <span class='flex flex-col min-w-0 leading-tight'>
                    <span class='text-[0.88rem] font-bold text-white'>{tj.titulo}</span>
                    {tj.subtitulo && <span class='hero-trust-sub text-[0.8rem] text-[color:var(--on-green-muted)] mt-1'>{tj.subtitulo}</span>}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <!-- Foto -->
      <div class='tile hero-foto !p-0' data-hero-slider={tieneCarrusel ? 'true' : undefined} style='--reveal-delay:160ms' data-reveal>
        {listaImagenes.length > 0 ? (
          listaImagenes.map((img, i) => (
            <FotoMarco
              url={img.url}
              alt={localizar(img.alt, lang) || (i === 0 ? nombre : '')}
              prioridad={i === 0}
              class={`hero-slide ${i === 0 ? 'is-active' : ''}`}
            />
          ))
        ) : (
          <div class='absolute inset-0 bg-[color:var(--canvas-alt)]' aria-hidden='true'></div>
        )}
        {tieneCarrusel && (
          <div class='hero-dots'>
            {/* WCAG 2.2.2: el carrusel automático debe poder pausarse */}
            <button type='button' class='hero-pausa' data-hero-pausa aria-pressed='false'
                    data-label-pausar={t('hero.carrusel.pausar', lang)} data-label-reanudar={t('hero.carrusel.reanudar', lang)}
                    aria-label={t('hero.carrusel.pausar', lang)}>
              <svg class='icono-pausa' width='10' height='10' viewBox='0 0 10 10' aria-hidden='true'><rect x='1.5' y='1' width='2.4' height='8' rx='0.6' fill='currentColor'/><rect x='6.1' y='1' width='2.4' height='8' rx='0.6' fill='currentColor'/></svg>
              <svg class='icono-play' width='10' height='10' viewBox='0 0 10 10' aria-hidden='true'><path d='M2.5 1.2v7.6L8.8 5z' fill='currentColor'/></svg>
            </button>
            {listaImagenes.map((_, i) => (
              <button type='button' class={`hero-dot ${i === 0 ? 'is-active' : ''}`} data-hero-dot={String(i)}
                      aria-label={t('hero.carrusel.foto', lang, { n: String(i + 1), total: String(listaImagenes.length) })}
                      aria-current={i === 0 ? 'true' : undefined}></button>
            ))}
          </div>
        )}
      </div>

      <!-- Estado de apertura en tiempo real -->
      {horariosLimpios.length > 0 && (
        <a href='#contacto' class='tile tile-soft hero-estado' data-hero-estado data-horarios={JSON.stringify(horariosLimpios)} data-textos={textosEstadoJson}
           style='--reveal-delay:240ms' data-reveal>
          <span class='flex items-center gap-3'>
            <span class='hero-estado-dot' aria-hidden='true'></span>
            <span class='hero-estado-titulo' data-estado-titulo>&nbsp;</span>
          </span>
          <span class='hero-estado-detalle' data-estado-detalle>&nbsp;</span>
          <span class='hero-estado-link'>
            {t('hero.estado.verHorario', lang)}
            <svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6' /></svg>
          </span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    gap: clamp(0.75rem, 1.4vw, 1rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.45fr 1fr;
      grid-template-rows: 1fr auto;
      min-height: min(78vh, 720px);
    }
    .hero-main { grid-row: 1 / span 2; }
  }

  .hero-main { padding: clamp(1.75rem, 4vw, 3.25rem); }
  .hero-main-glow {
    position: absolute;
    right: -20%;
    top: -30%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(200, 232, 69, 0.28), transparent 65%);
    pointer-events: none;
  }

  .hero-trust { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 620px) {
    .hero-trust-item { flex-direction: column; }
  }
  @media (min-width: 960px) {
    .hero-trust-sub { display: none; }
  }
  /* Informativas: sin caja ni borde, para que no parezcan botones */
  .hero-trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--green-line);
  }
  .hero-trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--brand-lime);
    color: var(--green-2);
  }

  .hero-foto { aspect-ratio: 4 / 3; min-width: 0; }
  @media (min-width: 960px) {
    .hero-foto { aspect-ratio: auto; min-height: 0; }
  }
  .hero-foto :global(.hero-slide) { opacity: 0; transition: opacity 800ms var(--ease-in-out); }
  .hero-foto :global(.hero-slide.is-active) { opacity: 1; }
  .hero-dots {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: inline-flex;
    gap: 0;
    padding: 2px 6px;
    border-radius: 999px;
    background: rgba(11, 21, 16, 0.45);
    backdrop-filter: blur(8px);
  }
  .hero-pausa {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 2px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .hero-pausa[hidden] { display: none; }
  .hero-pausa .icono-play { display: none; }
  .hero-pausa[aria-pressed='true'] .icono-play { display: block; }
  .hero-pausa[aria-pressed='true'] .icono-pausa { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .hero-pausa:hover { background: rgba(255, 255, 255, 0.18); }
  }

  /* Botón de 24×24 (zona táctil WCAG 2.5.8) con el punto dibujado dentro */
  .hero-dot {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .hero-dot::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    transition: width var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .hero-dot.is-active::before { width: 20px; background: #fff; }
  @media (hover: hover) and (pointer: fine) {
    .hero-dot:not(.is-active):hover::before { background: rgba(255, 255, 255, 0.85); }
  }

  .hero-estado {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--foreground-strong);
    transition: background-color var(--dur) var(--ease-out);
  }
  .hero-estado-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--primary);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--primary) 18%, transparent);
    animation: motion-pulse 2.5s var(--ease-in-out) infinite;
  }
  .hero-estado.is-closed .hero-estado-dot {
    background: var(--danger);
    box-shadow: 0 0 0 5px rgba(180, 35, 24, 0.14);
    animation: none;
  }
  .hero-estado-titulo {
    font-size: clamp(1.35rem, 1.4vw + 0.9rem, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .hero-estado-detalle { font-size: 0.95rem; color: var(--muted-foreground); }
  .hero-estado-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
  }
  .hero-estado-link svg { transition: transform var(--dur) var(--ease-magnetic); }
  @media (hover: hover) and (pointer: fine) {
    .hero-estado:hover { background: var(--surface-strong); }
    .hero-estado:hover .hero-estado-link svg { transform: translateX(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-foto :global(.hero-slide) { transition: none; }
    .hero-estado-dot { animation: none; }
  }
</style>

<script>
  import { calcularEstado } from '@/lib/estadoHorario';
  /* Carrusel de la foto. */
  const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
  if (slider) {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    let indice = 0;
    let timer: number | undefined;
    const mostrar = (i: number) => {
      indice = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === indice));
      dots.forEach((d, k) => {
        d.classList.toggle('is-active', k === indice);
        if (k === indice) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };
    const iniciar = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => mostrar(indice + 1), 6000);
    };
    const pausa = slider.querySelector<HTMLButtonElement>('[data-hero-pausa]');
    let pausadoPorUsuario = false;
    const detener = () => window.clearInterval(timer);
    const reanudar = () => { if (!pausadoPorUsuario && !sinMovimiento) iniciar(); };
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    dots.forEach((d, i) => d.addEventListener('click', () => { mostrar(i); reanudar(); }));
    if (sinMovimiento) {
      pausadoPorUsuario = true; // con movimiento reducido no avanza solo
      pausa?.setAttribute('hidden', '');
    } else {
      iniciar();
      document.addEventListener('visibilitychange', () => (document.hidden ? detener() : reanudar()));
      // se para mientras el usuario mira o navega por las fotos
      slider.addEventListener('mouseenter', detener);
      slider.addEventListener('mouseleave', reanudar);
      slider.addEventListener('focusin', detener);
      slider.addEventListener('focusout', reanudar);
      pausa?.addEventListener('click', () => {
        pausadoPorUsuario = !pausadoPorUsuario;
        pausa.setAttribute('aria-pressed', String(pausadoPorUsuario));
        pausa.setAttribute('aria-label', pausadoPorUsuario ? pausa.dataset.labelReanudar! : pausa.dataset.labelPausar!);
        if (pausadoPorUsuario) detener();
      });
    }
  }

  /* Reveal palabra a palabra del titular. */
  const palabras = document.querySelectorAll<HTMLElement>('[data-reveal-word]');
  requestAnimationFrame(() => palabras.forEach((p) => p.classList.add('in-view')));

  /* Abierto / cerrado con la hora de Madrid. */
  const estado = document.querySelector<HTMLElement>('[data-hero-estado]');
  if (estado) {
    try {
      const r = calcularEstado(JSON.parse(estado.dataset.horarios ?? '[]'), JSON.parse(estado.dataset.textos ?? '{}'));
      estado.classList.toggle('is-closed', !r.abierto);
      estado.querySelector<HTMLElement>('[data-estado-titulo]')!.textContent = r.titulo;
      estado.querySelector<HTMLElement>('[data-estado-detalle]')!.textContent = r.detalle;
    } catch {
      estado.hidden = true;
    }
  }
</script>
