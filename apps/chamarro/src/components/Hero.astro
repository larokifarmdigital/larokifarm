---
import { localizar, type ImagenConAlt, type LocalizedString, type TarjetaFlotante } from '@/lib/sanity';
import { t, type Locale } from '@/lib/i18n';
import IconoServicio from '@/components/IconoServicio.astro';

interface Props {
  nombre: string;
  ciudad?: string;
  imagenes?: ImagenConAlt[];
  telefono?: string;
  chip?: LocalizedString;
  titulo?: LocalizedString;
  claim?: string;
  tarjetasFlotantes?: TarjetaFlotante[];
  lang: Locale;
}

const { nombre, ciudad, imagenes, telefono, chip, titulo, claim, tarjetasFlotantes, lang } = Astro.props;

const listaImagenes = (imagenes ?? []).filter((i) => i?.url).slice(0, 6);
const tieneCarrusel = listaImagenes.length > 1;
const imagenHero = listaImagenes[0]?.url;

const chipTexto =
  localizar(chip, lang) ||
  (ciudad
    ? t('hero.chip.conCiudad', lang, { ciudad })
    : t('hero.chip.sinCiudad', lang));

const tituloTexto = localizar(titulo, lang) || t('hero.tituloDefecto', lang);
const subtituloTexto = claim;

/* Palabras del título para word-by-word reveal. */
const palabrasTitulo = tituloTexto.split(/\s+/).filter(Boolean);

const tarjetasSanity = (tarjetasFlotantes ?? [])
  .map((tj) => ({
    icono: tj.icono,
    titulo: localizar(tj.titulo, lang),
    subtitulo: localizar(tj.subtitulo, lang),
  }))
  .filter((tj) => Boolean(tj.titulo));

const tarjetasDefault = [
  { icono: 'shield', titulo: t('hero.trust.colegiados', lang), subtitulo: t('hero.trust.colegiadosSub', lang) },
  { icono: 'clock', titulo: t('hero.trust.horario', lang), subtitulo: t('hero.trust.horarioSub', lang) },
  { icono: 'heart-pulse', titulo: t('hero.trust.consejo', lang), subtitulo: t('hero.trust.consejoSub', lang) },
] as const;

const tarjetasFinal = tarjetasSanity.length > 0 ? tarjetasSanity : tarjetasDefault;
---

<section
  class='hero relative min-h-[100dvh] flex items-center pt-[clamp(5rem,12vw,8rem)] pb-[clamp(4rem,8vw,6rem)] overflow-hidden'
  aria-label={t('hero.altInterior', lang, { nombre })}
>
  <div class='container-app relative w-full'>
    <div class='grid grid-cols-1 min-[900px]:grid-cols-[1.15fr_1fr] gap-[clamp(3rem,6vw,6rem)] items-center'>

      <!-- IZQUIERDA · texto editorial con word-by-word stagger -->
      <div class='hero-text flex flex-col gap-[clamp(1.75rem,2.5vw,2.25rem)]'>
        <span class='section-eyebrow self-start' data-reveal>{chipTexto}</span>

        <h1 class='h-display m-0 max-w-[15ch]'>
          {palabrasTitulo.map((palabra, i) => (
            <>
              <span class='inline-block' style={`--reveal-delay:${120 + i * 90}ms`} data-reveal-word>{palabra}</span>
              {i < palabrasTitulo.length - 1 && ' '}
            </>
          ))}
        </h1>

        {subtituloTexto && (
          <p class='hero-sub text-[clamp(1.05rem,1vw+0.75rem,1.2rem)] leading-[1.65] text-[color:var(--muted-foreground)] max-w-[48ch] m-0'
             style={`--reveal-delay:${120 + palabrasTitulo.length * 90 + 100}ms`}
             data-reveal>
            {subtituloTexto}
          </p>
        )}

        <div class='inline-flex gap-3 flex-wrap' style={`--reveal-delay:${120 + palabrasTitulo.length * 90 + 200}ms`} data-reveal>
          <a href='#servicios' class='btn btn-primary'>
            {t('hero.btnServicios', lang)}
            <span class='btn-icon-nested' aria-hidden='true'>
              <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>
                <path d='M5 12h14M13 6l6 6-6 6' />
              </svg>
            </span>
          </a>
          {telefono && (
            <a href={`tel:${telefono.replace(/\s+/g, '')}`} class='btn btn-secondary'>
              {t('hero.btnLlamar', lang)}
            </a>
          )}
        </div>

        {tarjetasFinal.length > 0 && (
          <ul class='hero-trust list-none p-0 mt-[clamp(2rem,4vw,3rem)] pt-8 border-t border-[color:var(--border)] grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-5 m-0'>
            {tarjetasFinal.map((tj, idx) => (
              <li
                class='flex flex-col gap-2'
                style={`--reveal-delay:${120 + palabrasTitulo.length * 90 + 400 + idx * 90}ms`}
                data-reveal
              >
                <span class='inline-flex items-center justify-center w-6 h-6 text-[color:var(--muted)]' aria-hidden='true'>
                  <IconoServicio nombre={tj.icono ?? 'shield'} size={16} />
                </span>
                <div class='flex flex-col leading-tight min-w-0'>
                  <span class='text-[0.9rem] font-medium text-[color:var(--foreground-strong)] tracking-[-0.01em]'>{tj.titulo}</span>
                  {tj.subtitulo && (
                    <span class='text-[0.82rem] text-[color:var(--muted)] mt-1 leading-[1.5]'>{tj.subtitulo}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- DERECHA · imagen protagonista con float sutil y kickers flotantes -->
      <div class='hero-visual relative' style='--reveal-delay:280ms' data-reveal>
        <div class='hero-visual-inner motion-float'>
          <div class='hero-image-frame relative aspect-[4/5] max-w-[520px] mx-auto rounded-[var(--radius-lg)] overflow-hidden bg-[color:var(--surface)] border border-[color:var(--border)]'
               data-hero-slider={tieneCarrusel ? 'true' : undefined}>
            {imagenHero ? (
              listaImagenes.map((img, i) => (
                <img
                  src={img.url}
                  alt={i === 0 ? nombre : ''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  class={`hero-slide absolute inset-0 w-full h-full object-cover block ${i === 0 ? 'is-active' : ''}`}
                  data-idx={String(i)}
                />
              ))
            ) : (
              <div class='absolute inset-0 flex items-center justify-center text-[color:var(--muted)] font-mono text-xs' aria-hidden='true'>
                <span>Farmacia Chamarro</span>
              </div>
            )}

            {tieneCarrusel && (
              <div
                class='absolute bottom-4 left-1/2 -translate-x-1/2 inline-flex gap-1.5 z-10 bg-white/90 px-2.5 py-1.5 border border-[color:var(--border)]'
                style='border-radius: var(--radius-xs);'
                role='tablist'
                aria-label='Cambiar imagen del hero'
              >
                {listaImagenes.map((_, i) => (
                  <button
                    type='button'
                    class={`hero-dot h-1.5 rounded-full bg-[color:var(--muted)]/40 border-none cursor-pointer ${i === 0 ? 'is-active' : ''}`}
                    data-hero-dot={String(i)}
                    aria-label={`Imagen ${i + 1} de ${listaImagenes.length}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    role='tab'
                  ></button>
                ))}
              </div>
            )}
          </div>

          {/* Kicker · "Abierto ahora" con dot pulsante */}
          <div class='hero-kicker hero-kicker--open' aria-hidden='true'>
            <span class='inline-flex items-center gap-2'>
              <span class='w-1.5 h-1.5 rounded-full bg-[color:var(--success)] motion-pulse'></span>
              <span class='text-[0.78rem] font-medium text-[color:var(--foreground)] tracking-[-0.005em]'>Abierto ahora</span>
            </span>
          </div>

          {/* Kicker · marca serif itálica */}
          <div class='hero-kicker hero-kicker--serif hidden min-[900px]:flex' aria-hidden='true'>
            <span class='hero-kicker-line'></span>
            <span class='hero-kicker-text'>Farmacia · Barcelona</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--background);
  }

  .hero-visual-inner { position: relative; max-width: 520px; margin-inline: auto; }

  /* Kicker "Abierto ahora" — pill top-right del visual, con entrada sutil */
  .hero-kicker--open {
    position: absolute;
    top: -12px;
    right: -8px;
    padding: 0.55rem 0.95rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 9999px;
    z-index: 3;
    box-shadow: var(--shadow-hover);
    animation: kicker-in 800ms var(--ease-editorial) 1400ms both;
  }

  /* Kicker serif — chip inferior con línea + serif */
  .hero-kicker--serif {
    position: absolute;
    bottom: -14px;
    left: -20px;
    align-items: center;
    gap: 10px;
    padding: 0.5rem 0.95rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 9999px;
    box-shadow: var(--shadow-hover);
    z-index: 3;
    animation: kicker-in 800ms var(--ease-editorial) 1600ms both;
  }
  .hero-kicker-line {
    width: 16px;
    height: 1px;
    background: var(--foreground);
  }
  .hero-kicker-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--muted-foreground);
  }
  @keyframes kicker-in {
    from { opacity: 0; transform: translateY(-8px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Cross-fade carrusel */
  .hero-slide {
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }
  .hero-slide.is-active { opacity: 1; }

  .hero-dot {
    width: 5px;
    transition:
      width var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .hero-dot.is-active {
    background: var(--foreground-strong);
    width: 18px;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-dot:hover { background: var(--foreground); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { transition: none; }
    .hero-visual-inner.motion-float { animation: none; }
    .hero-kicker--open, .hero-kicker--serif { animation: none; }
  }
</style>

<script>
  const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
  if (slider) {
    const slides = Array.from(slider.querySelectorAll<HTMLImageElement>('.hero-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    if (slides.length > 1) {
      let indice = 0;
      let timerId: number | undefined;
      const INTERVALO = 6000;

      function mostrar(i: number) {
        indice = ((i % slides.length) + slides.length) % slides.length;
        slides.forEach((s, idx) => s.classList.toggle('is-active', idx === indice));
        dots.forEach((d, idx) => {
          const activo = idx === indice;
          d.classList.toggle('is-active', activo);
          d.setAttribute('aria-selected', activo ? 'true' : 'false');
        });
      }

      function siguiente() { mostrar(indice + 1); }

      function iniciar() {
        detener();
        timerId = window.setInterval(siguiente, INTERVALO);
      }
      function detener() {
        if (timerId !== undefined) {
          window.clearInterval(timerId);
          timerId = undefined;
        }
      }

      dots.forEach((d, i) => {
        d.addEventListener('click', () => {
          mostrar(i);
          iniciar();
        });
      });

      const preferSinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!preferSinMovimiento) {
        iniciar();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) detener();
          else iniciar();
        });
      }
    }
  }

  /* Word reveal · trigger propio para las palabras del hero, ya que están
     fuera del observer global (usan data-reveal-word). */
  const words = document.querySelectorAll<HTMLElement>('[data-reveal-word]');
  if (words.length > 0 && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('in-view');
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.1 });
    words.forEach((w) => io.observe(w));
  }
</script>
