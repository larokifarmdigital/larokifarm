---
import { localizar, type FeatureItem } from '@/lib/sanity';
import IconoServicio from './IconoServicio.astro';
import { t, type Locale } from '@/lib/i18n';

interface Props {
  lista?: FeatureItem[];
  lang: Locale;
  horarioTexto?: string;
}

const { lista, lang, horarioTexto } = Astro.props;

const featuresSanity = (lista ?? [])
  .map((f) => ({
    icono: f.icono,
    titulo: localizar(f.titulo, lang),
    descripcion: localizar(f.descripcion, lang),
  }))
  .filter((f) => f.titulo);

const featuresFallback = [
  { icono: 'users' as const, titulo: t('features.atencionTitulo', lang), descripcion: t('features.atencionDesc', lang) },
  { icono: 'shield' as const, titulo: t('features.calidadTitulo', lang), descripcion: t('features.calidadDesc', lang) },
  { icono: 'stethoscope' as const, titulo: t('features.equipoTitulo', lang), descripcion: t('features.equipoDesc', lang) },
  { icono: 'clock' as const, titulo: t('features.horarioTitulo', lang), descripcion: horarioTexto || t('features.horarioDescFallback', lang) },
];

const items = featuresSanity.length > 0 ? featuresSanity : featuresFallback;

if (items.length === 0) return null;
---

<section
  class='py-[clamp(6rem,10vw,9rem)] bg-[color:var(--canvas-alt)] border-y border-[color:var(--border)]'
  aria-label='Nuestras ventajas'
>
  <div class='container-app'>
    <ul class='list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 min-[960px]:grid-cols-4 gap-0 border border-[color:var(--border)] rounded-[var(--radius-lg)] overflow-hidden bg-[color:var(--card)]'>
      {items.map((f, i) => (
        <li
          class='feature-item p-7 flex items-start gap-4 border-b border-[color:var(--border)] relative'
          data-reveal
          data-spotlight
          style={`--reveal-delay:${i * 100}ms;`}
        >
          <span class='feature-icon inline-flex items-center justify-center w-10 h-10 rounded-[var(--radius-sm)] bg-[color:var(--surface)] border border-[color:var(--border)] text-[color:var(--foreground)] shrink-0 mt-[2px]' aria-hidden='true'>
            <IconoServicio nombre={f.icono} size={20} />
          </span>
          <div class='flex flex-col gap-1.5 min-w-0 flex-1'>
            <h3 class='m-0 font-medium tracking-[-0.015em] leading-[1.3] text-[1.02rem] text-[color:var(--foreground-strong)]'>
              {f.titulo}
            </h3>
            {f.descripcion && (
              <p class='m-0 text-[0.9rem] text-[color:var(--muted)] leading-[1.55]'>{f.descripcion}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Grid interior tipo Notion · líneas divisorias internas mediante borders.
     Todos los items llevan border-b + border-right, luego quitamos los de
     última columna y última fila con nth-child. */
  .feature-item { border-right: none; }

  @media (min-width: 640px) and (max-width: 959px) {
    .feature-item:nth-child(2n-1) { border-right: 1px solid var(--border); }
  }
  @media (min-width: 960px) {
    .feature-item:nth-child(4n-3),
    .feature-item:nth-child(4n-2),
    .feature-item:nth-child(4n-1) { border-right: 1px solid var(--border); }
  }

  /* Icono con motion sutil al hover del container */
  .feature-icon {
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-magnetic);
  }
  @media (hover: hover) and (pointer: fine) {
    .feature-item:hover .feature-icon {
      background: var(--foreground-strong);
      color: var(--background);
      border-color: var(--foreground-strong);
      transform: scale(1.08) rotate(-3deg);
    }
    .feature-item {
      transition: background-color var(--dur) var(--ease-out);
    }
    .feature-item:hover {
      background: var(--surface);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-item:hover .feature-icon { transform: none; }
  }
</style>
