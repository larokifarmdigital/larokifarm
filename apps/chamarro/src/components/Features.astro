---
import { localizar, type FeatureItem } from '@/lib/sanity';
import IconoServicio from './IconoServicio.astro';
import { t, type Locale } from '@/lib/i18n';

interface Props {
  lista?: FeatureItem[];
  lang: Locale;
  horarioTexto?: string;
}

const { lista, lang, horarioTexto } = Astro.props;

const featuresSanity = (lista ?? [])
  .map((f) => ({
    icono: f.icono,
    titulo: localizar(f.titulo, lang),
    descripcion: localizar(f.descripcion, lang),
  }))
  .filter((f) => f.titulo);

const featuresFallback = [
  { icono: 'users' as const, titulo: t('features.atencionTitulo', lang), descripcion: t('features.atencionDesc', lang) },
  { icono: 'shield' as const, titulo: t('features.calidadTitulo', lang), descripcion: t('features.calidadDesc', lang) },
  { icono: 'stethoscope' as const, titulo: t('features.equipoTitulo', lang), descripcion: t('features.equipoDesc', lang) },
  { icono: 'clock' as const, titulo: t('features.horarioTitulo', lang), descripcion: horarioTexto || t('features.horarioDescFallback', lang) },
];

const items = featuresSanity.length > 0 ? featuresSanity : featuresFallback;

if (items.length === 0) return null;
---

<section class='features' aria-labelledby='features-titulo'>
  <h2 id='features-titulo' class='sr-only'>{t('features.aria', lang)}</h2>
  <div class='container-app pb-[clamp(3rem,6vw,5rem)]'>
    <ul class='list-none p-0 m-0 grid grid-cols-1 min-[560px]:grid-cols-2 min-[1000px]:grid-cols-4 gap-[clamp(0.75rem,1.4vw,1rem)]'>
      {items.map((f, i) => (
        <li class='tile feature-item flex items-start gap-4 min-w-0' data-reveal style={`--reveal-delay:${i * 80}ms;`}>
          <span class='feature-icon' aria-hidden='true'><IconoServicio nombre={f.icono} size={20} /></span>
          <div class='flex flex-col gap-1 min-w-0'>
            <h3 class='m-0 text-[1.02rem] font-bold leading-[1.3] tracking-[-0.02em] text-[color:var(--foreground-strong)]'>{f.titulo}</h3>
            {f.descripcion && <p class='m-0 text-[0.88rem] leading-[1.5] text-[color:var(--muted-foreground)]'>{f.descripcion}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Informativas, no clicables: sin efecto hover para no parecer botones */
  .feature-item { padding: 1.25rem 1.3rem; border-radius: var(--radius-lg); background: var(--canvas-alt); border-color: transparent; }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: var(--radius);
    background: var(--primary-soft);
    color: var(--primary);
  }
</style>
