---
import { localizar, type Servicio, type TextosCabecera } from '@/lib/contenido';
import IconoServicio from './IconoServicio.astro';
import { t, type Locale } from '@/lib/i18n';

interface Props {
  servicios?: Servicio[];
  lang: Locale;
  textos?: TextosCabecera;
}

const { servicios, lang, textos } = Astro.props;
const lista = (servicios ?? []).filter((s) => localizar(s.nombre, lang));

const chip = localizar(textos?.chip, lang) || t('servicios.chip', lang);
const titulo = localizar(textos?.titulo, lang) || t('servicios.titulo', lang);
const subtitulo = localizar(textos?.subtitulo, lang) || t('servicios.subtitulo', lang);
---

<section id='servicios' class='bg-[color:var(--canvas-alt)]'>
  <div class='container-app py-[clamp(4rem,7vw,6rem)]'>
    <header class='flex flex-col min-[900px]:flex-row min-[900px]:items-end min-[900px]:justify-between gap-5 mb-[clamp(2rem,4vw,3rem)]'>
      <div class='flex flex-col gap-4 max-w-[40rem]'>
        <span class='section-eyebrow' data-reveal>{chip}</span>
        <h2 class='h-section m-0' style='--reveal-delay:80ms' data-reveal>{titulo}</h2>
      </div>
      {subtitulo && (
        <p class='m-0 max-w-[36ch] text-[1.05rem] leading-[1.6] text-[color:var(--muted-foreground)]' style='--reveal-delay:160ms' data-reveal>{subtitulo}</p>
      )}
    </header>

    {lista.length === 0 ? (
      <p class='py-12 px-4 text-center text-[color:var(--muted)] bg-[color:var(--card)] border border-dashed border-[color:var(--border-strong)] rounded-[var(--radius-xl)]'>
        {t('servicios.placeholder', lang)}
      </p>
    ) : (
      <ul class='servicios-grid list-none p-0 m-0'>
        {lista.map((s, i) => {
          const nombre = localizar(s.nombre, lang);
          const descripcion = localizar(s.descripcion, lang);
          // Solo enlaces seguros: nada de javascript:, data:…
          const rawUrl = s.enlace?.url?.trim();
          const url = rawUrl && (!/^[a-z][a-z0-9+.-]*:/i.test(rawUrl.replace(/[\u0000-\u0020]/g, '')) || /^(https?|mailto|tel):/i.test(rawUrl)) ? rawUrl : undefined;
          const externo = s.enlace?.nuevaPestana;
          const destacado = i === 0;
          const clases = `tile servicio-card ${destacado ? 'tile-green servicio-card--destacado' : ''} ${url ? 'servicio-card--link' : ''}`;

          const contenido = (
            <>
              <span class='servicio-icon' aria-hidden='true'><IconoServicio nombre={s.icono} size={destacado ? 26 : 22} /></span>
              {destacado && <span class='servicio-marca' aria-hidden='true'><IconoServicio nombre={s.icono} size={220} /></span>}
              <h3 class={`h-card m-0 ${destacado ? 'servicio-titulo-grande' : ''}`}>{nombre}</h3>
              {descripcion && <p class='servicio-desc m-0'>{descripcion}</p>}
              {url && (
                <span class='servicio-mas' aria-hidden='true'>
                  {t('servicios.verMas', lang)}
                  <svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'>
                    {externo ? <path d='M7 17L17 7M9 7h8v8' /> : <path d='M5 12h14M13 6l6 6-6 6' />}
                  </svg>
                </span>
              )}
            </>
          );

          return (
            <li class={`min-w-0 ${destacado ? 'servicios-destacado' : ''}`}>
              {url ? (
                <a href={url} target={externo ? '_blank' : undefined} rel={externo ? 'noopener noreferrer' : undefined}
                   class={clases} data-reveal style={`--reveal-delay:${i * 70}ms`}>
                  {contenido}
                </a>
              ) : (
                <div class={clases} data-reveal style={`--reveal-delay:${i * 70}ms`}>{contenido}</div>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  .servicios-grid {
    display: grid;
    gap: clamp(0.75rem, 1.4vw, 1rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .servicios-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .servicios-destacado { grid-column: 1 / -1; }
  }
  @media (min-width: 1000px) {
    .servicios-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .servicios-destacado { grid-column: auto; grid-row: span 2; }
  }

  .servicio-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    text-decoration: none;
    color: var(--foreground);
    transition: border-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-magnetic), box-shadow var(--dur) var(--ease-out);
  }
  .servicio-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.9rem;
    border-radius: var(--radius);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .servicio-desc { font-size: 0.93rem; line-height: 1.6; color: var(--muted-foreground); }
  .servicio-mas {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.87rem;
    font-weight: 700;
    color: var(--primary);
  }
  .servicio-mas svg { transition: transform var(--dur) var(--ease-magnetic); }

  /* Destacado (primer servicio) en bloque verde */
  .servicio-card--destacado { justify-content: flex-start; }
  .servicio-marca {
    position: absolute;
    right: -2.5rem;
    bottom: -2.5rem;
    color: var(--brand-lime);
    opacity: 0.12;
    pointer-events: none;
    transform: rotate(-12deg);
  }
  .servicio-card--destacado > :not(.servicio-marca) { position: relative; }
  .servicio-card--destacado .servicio-icon { width: 60px; height: 60px; background: var(--brand-lime); color: var(--green-2); }
  .servicio-card--destacado .servicio-titulo-grande { font-size: clamp(1.5rem, 1.6vw + 1rem, 2.1rem); line-height: 1.12; letter-spacing: -0.035em; }
  .servicio-card--destacado .servicio-desc { color: var(--on-green-muted); font-size: 1rem; max-width: 40ch; }
  .servicio-card--destacado .servicio-mas { color: var(--brand-lime); }

  @media (hover: hover) and (pointer: fine) {
    .servicio-card--link:hover { border-color: var(--primary); transform: translateY(-3px); box-shadow: var(--shadow-soft); }
    .servicio-card--destacado.servicio-card--link:hover { border-color: transparent; }
    .servicio-card--link:hover .servicio-mas svg { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .servicio-card--link:hover { transform: none; }
  }
</style>
