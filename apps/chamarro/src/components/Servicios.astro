---
import { localizar, type Servicio, type TextosCabecera } from '@/lib/sanity';
import IconoServicio from './IconoServicio.astro';
import { t, type Locale } from '@/lib/i18n';

interface Props {
  servicios?: Servicio[];
  lang: Locale;
  textos?: TextosCabecera;
}

const { servicios, lang, textos } = Astro.props;
const lista = (servicios ?? []).filter((s) => localizar(s.nombre, lang));

const chip = localizar(textos?.chip, lang) || t('servicios.chip', lang);
const titulo = localizar(textos?.titulo, lang) || t('servicios.titulo', lang);
const subtitulo = localizar(textos?.subtitulo, lang) || t('servicios.subtitulo', lang);
---

<section id='servicios' class='py-[clamp(4.5rem,8vw,7rem)] bg-[color:var(--canvas-alt)]'>
  <div class='container-app'>
    <header class='max-w-[62ch] mb-[clamp(2.5rem,4vw,3.5rem)] flex flex-col gap-4'>
      <span class='section-eyebrow self-start' data-reveal>{chip}</span>
      <h2 class='h-section m-0' style='--reveal-delay:80ms' data-reveal>{titulo}</h2>
      {subtitulo && (
        <p class='mt-1 text-[color:var(--muted-foreground)] text-[1.05rem] leading-[1.65] max-w-[54ch]' style='--reveal-delay:160ms' data-reveal>
          {subtitulo}
        </p>
      )}
    </header>

    {lista.length === 0 ? (
      <p class='py-12 px-4 text-center text-[color:var(--muted)] bg-[color:var(--surface)] border border-dashed border-[color:var(--border-strong)] rounded-[var(--radius-lg)]'>
        {t('servicios.placeholder', lang)}
      </p>
    ) : (
      <ul class='list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 min-[960px]:grid-cols-3 gap-4 sm:gap-5'>
        {lista.map((s, i) => {
          const nombre = localizar(s.nombre, lang);
          const descripcion = localizar(s.descripcion, lang);
          const url = s.enlace?.url;
          const externo = s.enlace?.nuevaPestana;

          const contenido = (
            <>
              <div class='flex items-center justify-between gap-3'>
                <span class='servicio-icon inline-flex items-center justify-center w-11 h-11 rounded-[var(--radius-sm)] bg-[color:var(--surface)] border border-[color:var(--border)] text-[color:var(--foreground)] shrink-0' aria-hidden='true'>
                  <IconoServicio nombre={s.icono} size={20} />
                </span>
                {url && (
                  <span class='servicio-arrow inline-flex items-center justify-center w-8 h-8 rounded-[var(--radius-xs)] text-[color:var(--muted)] border border-[color:var(--border)] shrink-0' aria-hidden='true'>
                    <svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>
                      {externo ? <path d='M7 17L17 7M9 7h8v8' /> : <path d='M5 12h14M13 6l6 6-6 6' />}
                    </svg>
                  </span>
                )}
              </div>

              <div class='flex flex-col gap-2 mt-4'>
                <h3 class='m-0 h-card'>{nombre}</h3>
                {descripcion && (
                  <p class='m-0 text-[0.9rem] text-[color:var(--muted-foreground)] leading-[1.6] line-clamp-3'>
                    {descripcion}
                  </p>
                )}
              </div>
            </>
          );

          return (
            <li>
              {url ? (
                <a
                  href={url}
                  target={externo ? '_blank' : undefined}
                  rel={externo ? 'noopener noreferrer' : undefined}
                  class='servicio-card servicio-card--link card flex flex-col no-underline text-[color:var(--foreground)] cursor-pointer h-full min-h-[200px]'
                  data-reveal
                  data-spotlight
                  style={`--reveal-delay:${i * 90}ms`}
                >
                  {contenido}
                </a>
              ) : (
                <div class='servicio-card card flex flex-col h-full min-h-[200px]'
                     data-reveal
                     style={`--reveal-delay:${i * 90}ms`}>
                  {contenido}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  .servicio-card {
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-magnetic);
  }
  .servicio-icon,
  .servicio-arrow {
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-magnetic);
  }

  @media (hover: hover) and (pointer: fine) {
    .servicio-card--link:hover {
      border-color: var(--foreground-strong);
      box-shadow: var(--shadow-lift);
      transform: translateY(-4px);
    }
    .servicio-card--link:hover .servicio-arrow {
      background: var(--foreground-strong);
      color: var(--background);
      border-color: var(--foreground-strong);
      transform: translateX(3px);
    }
    .servicio-card--link:hover .servicio-icon {
      background: var(--foreground-strong);
      color: var(--background);
      border-color: var(--foreground-strong);
      transform: scale(1.05) rotate(-3deg);
    }
  }

  .servicio-card--link:active {
    transform: scale(0.99);
    transition-duration: var(--dur-press);
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .servicio-card--link:hover,
    .servicio-card--link:active { transform: none; }
    .servicio-card--link:hover .servicio-arrow,
    .servicio-card--link:hover .servicio-icon { transform: none; }
  }
</style>
