---
import { localizar, type Faq, type TextosCabecera } from '@/lib/sanity';
import { t, type Locale } from '@/lib/i18n';

interface Props {
  faqs?: Faq[];
  textos?: TextosCabecera;
  lang: Locale;
}

const { faqs, textos, lang } = Astro.props;
const lista = (faqs ?? []).filter((f) => localizar(f.pregunta, lang) && localizar(f.respuesta, lang));

const chip = localizar(textos?.chip, lang) || t('faqs.chip', lang);
const titulo = localizar(textos?.titulo, lang) || t('faqs.titulo', lang);
const subtitulo = localizar(textos?.subtitulo, lang) || t('faqs.subtitulo', lang);

if (lista.length === 0) return null;
---

<section id='faqs' class='py-[clamp(4rem,7vw,6rem)] bg-[color:var(--canvas-alt)]'>
  <div class='container-app grid grid-cols-1 min-[900px]:grid-cols-[1fr_1.8fr] gap-[clamp(2rem,4vw,3rem)] min-[900px]:gap-16 items-start'>
    <header class='flex flex-col gap-3'>
      <span class='section-eyebrow'>{chip}</span>
      <h2 class='h-section mt-1'>{titulo}</h2>
      {subtitulo && <p class='mt-2 text-[color:var(--muted-foreground)] leading-relaxed max-w-[36ch]'>{subtitulo}</p>}
    </header>

    {/* Acordeón: <details> nativo (funciona sin JS) mejorado con JS para
        animar también el cierre y reservar la altura de la respuesta más
        larga, así abrir/cerrar no desplaza el resto de la página. */}
    <div class='faq-lista' data-faqs>
      {lista.map((f, i) => (
        <details class='faq-item' name='faqs' open={i === 0} data-expanded={i === 0 ? 'true' : 'false'}>
          <summary class='faq-summary'>
            <span class='faq-pregunta'>{localizar(f.pregunta, lang)}</span>
            <span class='faq-signo' aria-hidden='true'>
              <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round'>
                <path class='faq-signo-v' d='M12 5v14' />
                <path d='M5 12h14' />
              </svg>
            </span>
          </summary>
          <div class='faq-anim'>
            <div class='faq-anim-inner'>
              <p class='faq-respuesta'>{localizar(f.respuesta, lang)}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-lista {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    position: relative;
    background: var(--card);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    transition:
      border-color 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }
  .faq-item::before {
    /* barra verde a la izquierda cuando está abierta */
    content: '';
    position: absolute;
    left: -1px;
    top: 18px;
    bottom: 18px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--primary);
    transform: scaleY(0);
    transition: transform 400ms var(--ease-out);
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    user-select: none;
    border-radius: var(--radius-lg);
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary:focus-visible { outline-offset: -2px; }

  .faq-pregunta {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--foreground-strong);
    transition: color 250ms var(--ease-out);
  }

  .faq-signo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary);
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      transform 400ms var(--ease-spring);
  }
  /* El "+" se convierte en "−": la barra vertical se pliega */
  .faq-signo-v {
    transform-origin: 12px 12px;
    transition: transform 350ms var(--ease-out), opacity 250ms var(--ease-out);
  }

  /* Altura animada con el truco grid-rows 0fr → 1fr */
  .faq-anim {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 420ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .faq-anim-inner { overflow: hidden; min-height: 0; }
  .faq-respuesta {
    margin: 0;
    padding: 0 4.5rem 1.4rem 1.5rem;
    max-width: 68ch;
    color: var(--muted-foreground);
    line-height: 1.7;
    font-size: 0.95rem;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 260ms var(--ease-out),
      transform 360ms var(--ease-out);
  }

  /* Estado abierto: data-expanded lo controla el JS (anima apertura y cierre).
     Sin JS se usa el [open] nativo. */
  .faq-item[data-expanded='true'],
  .faq-lista:not([data-js]) .faq-item[open] {
    border-color: color-mix(in oklab, var(--primary) 35%, transparent);
    box-shadow: var(--shadow-soft);
  }
  .faq-item[data-expanded='true']::before,
  .faq-lista:not([data-js]) .faq-item[open]::before { transform: scaleY(1); }
  .faq-item[data-expanded='true'] .faq-pregunta,
  .faq-lista:not([data-js]) .faq-item[open] .faq-pregunta { color: var(--primary); }
  .faq-item[data-expanded='true'] .faq-signo,
  .faq-lista:not([data-js]) .faq-item[open] .faq-signo {
    background: var(--primary);
    color: #fff;
    transform: rotate(180deg);
  }
  .faq-item[data-expanded='true'] .faq-signo-v,
  .faq-lista:not([data-js]) .faq-item[open] .faq-signo-v { transform: scaleY(0); opacity: 0; }
  .faq-item[data-expanded='true'] .faq-anim,
  .faq-lista:not([data-js]) .faq-item[open] .faq-anim { grid-template-rows: 1fr; }
  .faq-item[data-expanded='true'] .faq-respuesta,
  .faq-lista:not([data-js]) .faq-item[open] .faq-respuesta {
    opacity: 1;
    transform: none;
    transition-delay: 90ms, 60ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-item:not([data-expanded='true']):hover { border-color: var(--border-strong); }
    .faq-item:not([data-expanded='true']):hover .faq-pregunta { color: var(--primary); }
    .faq-item:not([data-expanded='true']):hover .faq-signo { transform: rotate(90deg); }
  }

  @media (max-width: 560px) {
    .faq-summary { padding: 1.1rem 1.15rem; }
    .faq-respuesta { padding: 0 1.15rem 1.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item, .faq-item::before, .faq-signo, .faq-signo-v, .faq-anim, .faq-respuesta { transition: none !important; }
  }
</style>

<script>
  const lista = document.querySelector<HTMLElement>('[data-faqs]');
  if (lista) {
    lista.dataset.js = '';
    const items = Array.from(lista.querySelectorAll<HTMLDetailsElement>('.faq-item'));
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURACION = sinMovimiento ? 0 : 430;

    /* Cierra con animación: primero colapsa (data-expanded=false) y, al
       terminar, quita el [open] nativo. */
    const cerrar = (item: HTMLDetailsElement) => {
      if (item.dataset.expanded !== 'true') return;
      item.dataset.expanded = 'false';
      window.setTimeout(() => {
        if (item.dataset.expanded === 'false') item.open = false;
      }, DURACION);
    };
    const abrir = (item: HTMLDetailsElement) => {
      items.forEach((otro) => otro !== item && cerrar(otro));
      item.open = true;
      // doble rAF: deja pintar el estado colapsado antes de expandir
      requestAnimationFrame(() => requestAnimationFrame(() => { item.dataset.expanded = 'true'; }));
    };

    items.forEach((item) => {
      // Sin el atributo name el navegador no cierra los otros por su cuenta:
      // lo gestionamos aquí para poder animar el cierre.
      item.removeAttribute('name');
      item.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        if (item.dataset.expanded === 'true') cerrar(item);
        else abrir(item);
      });
    });

    /* Reserva la altura de la respuesta más larga: así la sección no crece ni
       encoge al abrir/cerrar y no empuja el resto de la página. */
    const reservarAltura = () => {
      lista.style.minHeight = '';
      // Los <details> cerrados no pintan su contenido: los abrimos un instante
      // (siguen plegados por CSS) para medir, y los devolvemos a su estado.
      const estabanAbiertos = items.map((it) => it.open);
      items.forEach((it) => { it.open = true; });
      const inner = (it: HTMLDetailsElement) => it.querySelector<HTMLElement>('.faq-anim-inner');
      const alturaVisible = items.reduce((s2, it) => s2 + (inner(it)?.offsetHeight ?? 0), 0);
      const cerrada = lista.offsetHeight - alturaVisible;
      const maxRespuesta = Math.max(0, ...items.map((it) => inner(it)?.scrollHeight ?? 0));
      items.forEach((it, k) => { it.open = estabanAbiertos[k]; });
      lista.style.minHeight = `${Math.ceil(cerrada + maxRespuesta)}px`;
    };
    reservarAltura();
    let timer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(reservarAltura, 150);
    });
    document.fonts?.ready.then(reservarAltura);
  }
</script>
