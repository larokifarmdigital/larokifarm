---
/**
 * Vista previa del editor: la home con lo GUARDADO, renderizada en servidor por petición.
 * Solo con enlace firmado (`?t=`, lo valida el backoffice) y solo en iframe del backoffice; sin indexar ni caché.
 * `?seccion=&etiqueta=` resalta una sección (cambia por postMessage); `?pagina=aviso-legal|politica-privacidad` muestra esa página legal.
 */
import LegalPage from '@/components/LegalPage.astro';
import PaginaInicio from '@/components/PaginaInicio.astro';
import { mostrarResenasDe } from '@/lib/ajustes';
import { obtenerFarmaciaVistaPrevia, obtenerResenasBackoffice, ORIGEN_BACKOFFICE } from '@/lib/backoffice';
import { SLUG_FARMACIA } from '@/lib/contenido';
import { esLocaleValido, LOCALE_DEFECTO, type Locale } from '@/lib/i18n';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Content-Security-Policy', `frame-ancestors ${ORIGEN_BACKOFFICE}`);

const q = Astro.url.searchParams;
const token = q.get('t') ?? '';
const idioma = q.get('lang') ?? '';
const lang: Locale = esLocaleValido(idioma) ? idioma : LOCALE_DEFECTO;
const LEGALES = { 'aviso-legal': 'aviso', 'politica-privacidad': 'privacidad' } as const;
const legal = LEGALES[(q.get('pagina') ?? '') as keyof typeof LEGALES];

const farmacia = token ? await obtenerFarmaciaVistaPrevia(SLUG_FARMACIA, token) : null;
if (!farmacia) Astro.response.status = 401;

// Mismas reglas que la home publicada (10 recientes, 4-5★ con texto), sin caché.
const resenas = farmacia && !legal
  ? await obtenerResenasBackoffice(SLUG_FARMACIA, 10, 4, true, true)
  : { total: 0, media: 0, destacadas: [], recientes: [] };
---

{
  farmacia && legal ? (
    <LegalPage farmacia={farmacia} lang={lang} tipo={legal} mostrarResenas={mostrarResenasDe(farmacia)} vistaPrevia>
      <div data-vista-previa data-origen={ORIGEN_BACKOFFICE} hidden />
    </LegalPage>
  ) : farmacia ? (
    <PaginaInicio farmacia={farmacia} lang={lang} resenas={resenas} mostrarResenas={mostrarResenasDe(farmacia)} vistaPrevia>
      <div data-vista-previa data-origen={ORIGEN_BACKOFFICE} hidden />
    </PaginaInicio>
  ) : (
    <html lang='es'>
      <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <meta name='robots' content='noindex,nofollow' />
        <title>Vista previa no disponible</title>
      </head>
      <body style='margin:0;font:16px/1.5 system-ui,sans-serif;color:#1f2937;background:#f8fafc;display:grid;place-items:center;min-height:100vh;padding:16px;box-sizing:border-box'>
        <main style='max-width:36rem;text-align:center'>
          <h1 style='font-size:20px;margin:0 0 8px'>Esta vista previa ha caducado</h1>
          <p style='margin:0'>Vuelve a abrirla desde el editor del backoffice.</p>
        </main>
      </body>
    </html>
  )
}

<script>
  const raiz = document.querySelector<HTMLElement>('[data-vista-previa]');
  if (raiz) {
    const origen = raiz.dataset.origen ?? '';

    // Clave de la sección del editor → dónde sale en la página. Vacío = no sale en la página.
    const DONDE: Record<string, string[]> = {
      general: ['#contacto', '#contacto-footer'],
      horario: ['#contacto', '#contacto-footer'],
      idiomas: ['header'],
      hero: ['#inicio'],
      features: ['#puntos-fuertes'],
      sobre: ['#sobre'],
      servicios: ['#servicios'],
      faqs: ['#faqs'],
      resenas: ['#resenas'],
      legal: ['main.legal'],
      seo: [],
      chat: [],
    };

    const capa = document.createElement('div');
    capa.setAttribute('aria-hidden', 'true');
    capa.lang = 'es';
    capa.style.cssText = 'position:absolute;inset:0 auto auto 0;width:0;height:0;pointer-events:none;z-index:2147483646';
    document.body.append(capa);
    // Lo fijo en pantalla (la cabecera) no se mueve al hacer scroll: su marco va en
    // una capa también fija, con coordenadas de la ventana.
    const capaFija = document.createElement('div');
    capaFija.setAttribute('aria-hidden', 'true');
    capaFija.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:2147483646';
    document.body.append(capaFija);

    const aviso = document.createElement('div');
    aviso.setAttribute('role', 'status');
    aviso.lang = 'es';
    aviso.style.cssText =
      'position:fixed;left:50%;bottom:16px;transform:translateX(-50%);max-width:calc(100% - 32px);box-sizing:border-box;' +
      'padding:10px 16px;border-radius:10px;background:#0f172a;color:#fff;font:600 14px/1.4 system-ui,sans-serif;' +
      'box-shadow:0 8px 24px rgba(0,0,0,.25);z-index:2147483647;text-align:center';
    aviso.hidden = true;
    document.body.append(aviso);

    let objetivos: HTMLElement[] = [];
    let etiquetaActual = '';

    /** Fijo en pantalla: él o un antepasado con position fixed o sticky. */
    function esFijo(el: HTMLElement): boolean {
      for (let n: HTMLElement | null = el; n && n !== document.body; n = n.parentElement) {
        const p = getComputedStyle(n).position;
        if (p === 'fixed' || p === 'sticky') return true;
      }
      return false;
    }

    function dibujar() {
      capa.replaceChildren();
      capaFija.replaceChildren();
      objetivos.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        if (!r.width || !r.height) return;
        const fijo = esFijo(el);
        const caja = document.createElement('div');
        caja.style.cssText =
          `position:absolute;left:${r.left + (fijo ? 0 : scrollX) + 4}px;top:${r.top + (fijo ? 0 : scrollY) + 4}px;` +
          `width:${r.width - 8}px;height:${r.height - 8}px;box-sizing:border-box;` +
          'border:3px solid #1265b5;border-radius:12px;box-shadow:0 0 0 4px rgba(18,101,181,.18)';
        if (i === 0 && etiquetaActual) {
          const chip = document.createElement('span');
          chip.textContent = `Editando: ${etiquetaActual}`;
          chip.style.cssText =
            'position:absolute;top:8px;left:8px;padding:4px 10px;border-radius:999px;background:#1265b5;color:#fff;' +
            'font:700 12px/1.4 system-ui,sans-serif;white-space:nowrap';
          caja.append(chip);
        }
        (fijo ? capaFija : capa).append(caja);
      });
    }

    function avisar(texto: string) {
      aviso.textContent = texto;
      aviso.hidden = !texto;
    }

    function resaltar(seccion: string, etiqueta: string, suave: boolean) {
      etiquetaActual = etiqueta;
      const selectores = DONDE[seccion];
      objetivos = (selectores ?? [])
        .map((s) => document.querySelector<HTMLElement>(s))
        .filter((el): el is HTMLElement => !!el && el.getClientRects().length > 0);
      dibujar();
      if (!selectores) return avisar('');
      if (selectores.length === 0) return avisar(`«${etiqueta}» no se ve en la página de inicio.`);
      if (objetivos.length === 0) return avisar(`«${etiqueta}» no sale ahora en la web: está vacía o desactivada.`);
      avisar('');
      // Lo fijo (la cabecera) siempre está a la vista: no hace falta moverse.
      if (esFijo(objetivos[0])) return;
      const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const top = objetivos[0].getBoundingClientRect().top + scrollY - 80;
      scrollTo({ top: Math.max(0, top), behavior: suave && !reducido ? 'smooth' : 'instant' });
    }

    // Las fotos y los textos cambian de alto al cargar: se recoloca el marco.
    new ResizeObserver(dibujar).observe(document.body);
    addEventListener('resize', dibujar);
    // Un sticky cambia de sitio al hacer scroll; los demás marcos no se mueven.
    addEventListener('scroll', () => objetivos.some(esFijo) && dibujar(), { passive: true });

    // Los enlaces llevarían a la web publicada: en la vista previa no se abren.
    document.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element | null)?.closest('a[href]');
        if (!a || (a.getAttribute('href') ?? '').startsWith('#')) return;
        e.preventDefault();
        avisar('En la vista previa los enlaces no se abren.');
        setTimeout(() => avisar(''), 2500);
      },
      true,
    );

    addEventListener('message', (e) => {
      if (e.origin !== origen || e.data?.tipo !== 'larokifarm:seccion') return;
      resaltar(String(e.data.seccion ?? ''), String(e.data.etiqueta ?? ''), true);
    });

    const q = new URLSearchParams(location.search);
    const inicial = q.get('seccion');
    if (inicial) resaltar(inicial, q.get('etiqueta') ?? '', false);
    if (parent !== window) parent.postMessage({ tipo: 'larokifarm:lista' }, origen);
  }
</script>
