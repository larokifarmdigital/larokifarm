---
import PaginaInicio from '@/components/PaginaInicio.astro';
import { obtenerFarmaciaPorSlug, obtenerResenasGoogle, SLUG_FARMACIA, type Farmacia } from '@/lib/contenido';
import { MOSTRAR_RESENAS } from '@/lib/feature-flags';
import { esLocaleValido, type Locale } from '@/lib/i18n';

export async function getStaticPaths() {
  const farmacia = await obtenerFarmaciaPorSlug(SLUG_FARMACIA);
  const codigos = (farmacia?.idiomasActivos ?? [{ codigo: 'es', nombre: 'Español' }])
    .map((i) => i.codigo)
    .filter(esLocaleValido);
  const lista = codigos.length > 0 ? codigos : (['es'] as Locale[]);
  return lista.map((c) => ({
    params: { lang: c === 'es' ? undefined : c },
    props: { farmacia, lang: c },
  }));
}

interface Props {
  farmacia: Farmacia | null;
  lang: Locale;
}

const { farmacia: farmaciaCargada, lang } = Astro.props as Props;
const farmacia: Farmacia = farmaciaCargada ?? {
  _id: 'placeholder',
  nombre: 'Farmacia Torrents',
  slug: SLUG_FARMACIA,
};

// En la home solo mostramos reseñas de 4-5 estrellas que tengan texto;
// en /resenas se ven todas (incluyendo las que solo tienen estrellas).
const resenas = await obtenerResenasGoogle(SLUG_FARMACIA, 10, 4, true);
---

<PaginaInicio farmacia={farmacia} lang={lang} resenas={resenas} mostrarResenas={MOSTRAR_RESENAS} />
