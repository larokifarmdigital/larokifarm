---
/**
 * Página legal común (aviso legal / política de privacidad): cabecera con miga
 * de pan, índice de secciones (de los h2 del texto), contenido legible y, al
 * final, enlace al otro texto legal. Todo funciona sin JavaScript.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import {
  agruparHorarios,
  localizar,
  portableTextAHtml,
  type Farmacia,
  type DiasI18n,
} from '@/lib/sanity';
import { rutaConLocale, t, type Locale, localesActivos, DIAS_POR_IDIOMA, CERRADO_POR_IDIOMA } from '@/lib/i18n';
import { legalPorDefecto, prepararTextoLegal } from '@/lib/legal';
import { MOSTRAR_RESENAS } from '@/lib/feature-flags';

interface Props {
  farmacia: Farmacia;
  lang: Locale;
  tipo: 'aviso' | 'privacidad';
}

const { farmacia, lang, tipo } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const RUTAS = { aviso: '/aviso-legal', privacidad: '/politica-privacidad' } as const;
const ruta = RUTAS[tipo];
const otro = tipo === 'aviso' ? 'privacidad' : 'aviso';

const titulo = t(tipo === 'aviso' ? 'legal.avisoTitulo' : 'legal.privacidadTitulo', lang);
const intro = t(tipo === 'aviso' ? 'legal.avisoIntro' : 'legal.privacidadIntro', lang);
const otroTitulo = t(otro === 'aviso' ? 'legal.avisoTitulo' : 'legal.privacidadTitulo', lang);
const otroIntro = t(otro === 'aviso' ? 'legal.avisoIntro' : 'legal.privacidadIntro', lang);

// Contenido del CMS; si está vacío, el texto por defecto (lib/legal.ts).
const porDefecto = legalPorDefecto(lang);
const htmlOriginal =
  tipo === 'aviso'
    ? portableTextAHtml(localizar(farmacia.avisoLegal, lang)) || porDefecto.avisoLegal
    : portableTextAHtml(localizar(farmacia.politicaPrivacidad, lang)) || porDefecto.politicaPrivacidad;
const { html, secciones } = prepararTextoLegal(htmlOriginal);

const DIAS_POR_LANG = DIAS_POR_IDIOMA as Record<Locale, DiasI18n>;
const horariosAgrupados = agruparHorarios(farmacia.horarios, DIAS_POR_LANG[lang], CERRADO_POR_IDIOMA[lang]);
const mostrarFaqs = (farmacia.faqs ?? []).some((f) => localizar(f.pregunta, lang) && localizar(f.respuesta, lang));

const canonical = `${siteUrl}${rutaConLocale(ruta, lang)}`;
const home = rutaConLocale('/', lang);
---

<BaseLayout
  titulo={`${titulo} · ${farmacia.nombre}`}
  descripcion={t(tipo === 'aviso' ? 'legal.avisoMeta' : 'legal.privacidadMeta', lang, { nombre: farmacia.nombre })}
  canonical={canonical}
  lang={lang}
  idiomas={localesActivos(farmacia.idiomasActivos)}
  rutaActual={ruta}
  nombreFarmacia={farmacia.nombre}
  logoFarmacia={farmacia.logo}
>
  <Header
    nombre={farmacia.nombre}
    whatsapp={farmacia.contacto?.whatsapp}
    telefono={farmacia.contacto?.telefono}
    logo={farmacia.logo}
    mostrarFaqs={mostrarFaqs}
    mostrarResenas={MOSTRAR_RESENAS}
    lang={lang}
    rutaActual={ruta}
    idiomasActivos={farmacia.idiomasActivos}
  />

  <main id='contenido' class='legal'>
    {/* Cabecera de la página */}
    <section id='arriba' class='legal-hero border-b border-[var(--border)]'>
      <div class='container-app py-10 md:py-14'>
        <nav aria-label={t('header.breadcrumb.aria', lang)}>
          <ol class='m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 text-sm text-[var(--muted-foreground)]'>
            <li>
              <a href={home} class='inline-flex min-h-6 items-center hover:text-[var(--primary)] hover:underline underline-offset-4'>
                {t('legal.inicio', lang)}
              </a>
            </li>
            <li aria-hidden='true' class='select-none'>›</li>
            <li><span aria-current='page' class='font-semibold text-[var(--foreground)]'>{titulo}</span></li>
          </ol>
        </nav>

        <p class='legal-eyebrow mt-6'>
          <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' />
          </svg>
          {t('legal.eyebrow', lang)}
        </p>
        <h1 class='mt-3 text-[2.25rem] md:text-5xl'>{titulo}</h1>
        <p class='mt-4 max-w-2xl text-lg leading-relaxed text-[var(--muted-foreground)]'>{intro}</p>
      </div>
    </section>

    <div class='container-app py-10 md:py-14'>
      <div class={`legal-grid ${secciones.length > 0 ? 'con-indice' : ''}`}>
        {secciones.length > 0 && (
          <>
            {/* Móvil: índice plegable (details funciona sin JS) */}
            <details class='legal-indice-movil lg:hidden'>
              <summary>
                <span>{t('legal.indice', lang)}</span>
                <svg class='chevron' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                  <path d='m6 9 6 6 6-6' />
                </svg>
              </summary>
              <nav aria-label={t('legal.indice', lang)}>
                <ol>
                  {secciones.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}
                </ol>
              </nav>
            </details>

            {/* Escritorio: índice fijo al hacer scroll */}
            <aside class='legal-indice hidden lg:block'>
              <nav aria-label={t('legal.indice', lang)}>
                <p class='legal-indice__titulo'>{t('legal.indice', lang)}</p>
                <ol>
                  {secciones.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}
                </ol>
              </nav>
            </aside>
          </>
        )}

        <div class='min-w-0'>
          <article class='legal-cms' set:html={html} />

          <div class='mt-10 flex flex-col gap-4'>
            <a href={rutaConLocale(RUTAS[otro], lang)} class='legal-otro group'>
              <span class='min-w-0'>
                <span class='legal-otro__eyebrow'>{t('legal.otros', lang)}</span>
                <span class='legal-otro__titulo'>{otroTitulo}</span>
                <span class='legal-otro__texto'>{otroIntro}</span>
              </span>
              <span class='legal-otro__flecha' aria-hidden='true'>
                <svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>
                  <path d='M5 12h14M13 6l6 6-6 6' />
                </svg>
              </span>
            </a>

            <div class='flex flex-wrap items-center justify-between gap-3 text-sm'>
              <a href={home} class='legal-accion'>
                <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                  <path d='m15 18-6-6 6-6' />
                </svg>
                {t('legal.volver', lang)}
              </a>
              <a href='#arriba' class='legal-accion'>
                {t('legal.volverArriba', lang)}
                <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                  <path d='m18 15-6-6-6 6' />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer
    nombre={farmacia.nombre}
    titular={farmacia.titular}
    numeroColegiado={farmacia.numeroColegiado}
    logo={farmacia.logo}
    contacto={farmacia.contacto}
    redes={farmacia.redesSociales}
    direccion={farmacia.direccion}
    mapsUrl={farmacia.googleMapsUrl}
    horarios={farmacia.horarios}
    horariosAgrupados={horariosAgrupados}
    descripcionCorta={farmacia.descripcionCorta}
    mostrarFaqs={mostrarFaqs}
    mostrarResenas={MOSTRAR_RESENAS}
    lang={lang}
    rutaActual={ruta}
  />
</BaseLayout>

<style>
  .legal-hero {
    background:
      radial-gradient(60rem 22rem at 85% -10%, color-mix(in oklch, var(--accent), transparent 82%), transparent 70%),
      color-mix(in oklch, var(--secondary), var(--card) 45%);
  }
  .legal-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .legal-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .legal-grid.con-indice {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
  }

  /* Índice escritorio */
  .legal-indice {
    position: sticky;
    top: 6rem;
  }
  .legal-indice__titulo {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .legal-indice ol,
  .legal-indice-movil ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .legal-indice a,
  .legal-indice-movil a {
    display: block;
    padding: 0.4rem 0.75rem;
    border-left: 2px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
  }
  .legal-indice a:hover,
  .legal-indice-movil a:hover {
    color: var(--primary);
    border-left-color: var(--primary);
  }

  /* Índice móvil */
  .legal-indice-movil {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .legal-indice-movil summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0 1rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .legal-indice-movil summary::-webkit-details-marker {
    display: none;
  }
  .legal-indice-movil .chevron {
    transition: transform 200ms ease;
    color: var(--primary);
  }
  .legal-indice-movil[open] .chevron {
    transform: rotate(180deg);
  }
  .legal-indice-movil nav {
    padding: 0 1rem 1rem;
  }

  /* Texto legal (inyectado con set:html → estilos globales dentro de .legal-cms) */
  .legal-cms {
    max-width: 70ch;
  }
  .legal-cms :global(h2) {
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 1.4rem;
    font-weight: 800;
    scroll-margin-top: 6rem;
  }
  .legal-cms :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .legal-cms :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .legal-cms :global(h4) {
    margin-top: 1rem;
    font-weight: 700;
  }
  .legal-cms :global(p),
  .legal-cms :global(li) {
    line-height: 1.75;
    color: color-mix(in oklch, var(--foreground), transparent 15%);
  }
  .legal-cms :global(p) {
    margin-top: 1rem;
  }
  .legal-cms :global(ul),
  .legal-cms :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .legal-cms :global(ul) {
    list-style: disc;
  }
  .legal-cms :global(ol) {
    list-style: decimal;
  }
  .legal-cms :global(a) {
    color: var(--primary);
    text-decoration: underline;
    word-break: break-word;
  }
  .legal-cms :global(strong) {
    color: var(--foreground);
  }

  /* Enlace al otro texto legal */
  .legal-otro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .legal-otro:hover {
    border-color: var(--primary);
    box-shadow: 0 12px 32px -18px color-mix(in oklch, var(--primary), transparent 40%);
  }
  .legal-otro__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted-foreground);
  }
  .legal-otro__titulo {
    display: block;
    margin-top: 0.15rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--foreground);
  }
  .legal-otro__texto {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: var(--muted-foreground);
  }
  .legal-otro__flecha {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--secondary);
    color: var(--primary);
    transition: transform 200ms ease;
  }
  .legal-otro:hover .legal-otro__flecha {
    transform: translateX(3px);
  }

  .legal-accion {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--muted-foreground);
    font-weight: 600;
    text-decoration: none;
  }
  .legal-accion:hover {
    color: var(--primary);
  }
</style>
