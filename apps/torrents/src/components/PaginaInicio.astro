---
/**
 * Página de inicio. La usan la web (pages/[...lang]/index.astro, en build y
 * con lo publicado) y la vista previa del editor (pages/vista-previa.astro, en
 * el servidor y con lo guardado). Todo lo que pinta llega por props.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Features from '@/components/Features.astro';
import Servicios from '@/components/Servicios.astro';
import About from '@/components/About.astro';
import Faqs from '@/components/Faqs.astro';
import ResenasGoogle from '@/components/ResenasGoogle.astro';
import CtaCard from '@/components/CtaCard.astro';
import CtaFlotante from '@/components/CtaFlotante.astro';
import Footer from '@/components/Footer.astro';
import {
  rangoDiasAbiertos,
  agruparHorarios,
  localizar,
  type Farmacia,
  type DiasI18n,
  type ResumenResenas,
} from '@/lib/contenido';
import { construirMetaSeo, farmaciaAJsonLd } from '@/lib/seo';
import { rutaConLocale, type Locale, localesActivos, DIAS_POR_IDIOMA, CERRADO_POR_IDIOMA } from '@/lib/i18n';

interface Props {
  farmacia: Farmacia;
  lang: Locale;
  resenas: ResumenResenas;
  mostrarResenas: boolean;
  vistaPrevia?: boolean;
}

const { farmacia, lang, resenas, mostrarResenas: MOSTRAR_RESENAS, vistaPrevia = false } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const meta = construirMetaSeo(farmacia, siteUrl, lang, rutaConLocale('/', lang));
const jsonLd = farmaciaAJsonLd(farmacia, siteUrl, lang, resenas, MOSTRAR_RESENAS);

const DIAS_POR_LANG = DIAS_POR_IDIOMA as Record<Locale, DiasI18n>;
const CERRADO: Record<Locale, string> = CERRADO_POR_IDIOMA;

const horarioTexto = rangoDiasAbiertos(farmacia.horarios, DIAS_POR_LANG[lang]);
const horariosAgrupados = agruparHorarios(farmacia.horarios, DIAS_POR_LANG[lang], CERRADO[lang]);
const mostrarFaqs = (farmacia.faqs ?? []).some(
  (f) => localizar(f.pregunta, lang) && localizar(f.respuesta, lang),
);

const claim = localizar(farmacia.descripcionCorta, lang);
---

<BaseLayout
  titulo={meta.titulo}
  descripcion={meta.descripcion}
  canonical={meta.canonical}
  imagenOg={meta.imagenOg}
  jsonLd={jsonLd}
  lang={lang}
  idiomas={localesActivos(farmacia.idiomasActivos)}
  rutaActual='/'
  nombreFarmacia={farmacia.nombre}
  logoFarmacia={farmacia.logo}
  vistaPrevia={vistaPrevia}
>
  <Header
    nombre={farmacia.nombre}
    whatsapp={farmacia.contacto?.whatsapp}
    telefono={farmacia.contacto?.telefono}
    logo={farmacia.logo}
    mostrarFaqs={mostrarFaqs}
    mostrarResenas={MOSTRAR_RESENAS}
    lang={lang}
    rutaActual='/'
    idiomasActivos={farmacia.idiomasActivos}
  />

  <main id='contenido'>
    <Hero
      nombre={farmacia.nombre}
      claim={claim}
      ciudad={farmacia.direccion?.ciudad}
      telefono={farmacia.contacto?.telefono}
      whatsapp={farmacia.contacto?.whatsapp}
      imagenes={farmacia.imagenes}
      logo={farmacia.logo}
      direccion={farmacia.direccion}
      lang={lang}
      chip={farmacia.heroChip}
      subtitulo={farmacia.heroSubtitulo}
      tarjetas={farmacia.heroTarjetasFlotantes}
    />

    <Features
      horarioTexto={horarioTexto}
      logo={farmacia.logo}
      lang={lang}
      lista={farmacia.featuresLista}
    />

    <Servicios
      servicios={farmacia.servicios}
      logo={farmacia.logo}
      lang={lang}
      textos={farmacia.textosServicios}
    />

    <About
      imagenes={farmacia.imagenesSobre}
      logo={farmacia.logo}
      titulo={farmacia.sobreNosotros?.titulo}
      descripcionLarga={farmacia.descripcionLarga}
      puntos={farmacia.sobreNosotros?.puntos}
      anyosExperiencia={farmacia.sobreNosotros?.anyosExperiencia}
      lang={lang}
      nombre={farmacia.nombre}
      chip={farmacia.sobreNosotros?.chip}
    />

    {MOSTRAR_RESENAS && (
      <ResenasGoogle
        resumen={resenas}
        logo={farmacia.logo}
        lang={lang}
        urlGoogleMaps={farmacia.googleMapsUrl}
        textos={farmacia.textosResenas}
      />
    )}

    <Faqs
      faqs={farmacia.faqs}
      logo={farmacia.logo}
      lang={lang}
      textos={farmacia.textosFaqs}
    />

    <CtaCard
      nombre={farmacia.nombre}
      telefono={farmacia.contacto?.telefono}
      whatsapp={farmacia.contacto?.whatsapp}
      direccion={farmacia.direccion}
      mapaUrl={farmacia.mapaUrl}
      horarios={horariosAgrupados}
      logo={farmacia.logo}
      lang={lang}
    />
  </main>

  <Footer
    nombre={farmacia.nombre}
    titular={farmacia.titular}
    numeroColegiado={farmacia.numeroColegiado}
    logo={farmacia.logo}
    contacto={farmacia.contacto}
    redes={farmacia.redesSociales}
    direccion={farmacia.direccion}
    mapsUrl={farmacia.googleMapsUrl}
    horarios={farmacia.horarios}
    horariosAgrupados={horariosAgrupados}
    descripcionCorta={farmacia.descripcionCorta}
    mostrarFaqs={mostrarFaqs}
    mostrarResenas={MOSTRAR_RESENAS}
    lang={lang}
    rutaActual='/'
  />

  <CtaFlotante whatsapp={farmacia.contacto?.whatsapp} lang={lang} />
  <slot />
</BaseLayout>
