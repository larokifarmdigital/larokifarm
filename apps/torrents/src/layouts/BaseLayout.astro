---
import '@/styles/global.css';
import gilroyRegular from '@/assets/fonts/Gilroy-Regular.ttf?url';
import gilroyBlack from '@/assets/fonts/Gilroy-Black.ttf?url';
import { LOCALES_DISPONIBLES, LOCALE_DEFECTO, rutaConLocale, type Locale } from '@/lib/i18n';
import { SLUG_FARMACIA } from '@/lib/sanity';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  titulo: string;
  descripcion?: string;
  canonical: string;
  imagenOg?: string;
  jsonLd?: unknown;
  lang: Locale;
  /** Ruta lógica (sin prefijo de idioma). Ej.: "/", "/aviso-legal". Para los hreflangs. */
  rutaActual?: string;
}

const { titulo, descripcion, canonical, imagenOg, jsonLd, lang, rutaActual = '/' } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImageAbsoluta = imagenOg?.startsWith('http')
  ? imagenOg
  : imagenOg
    ? `${siteUrl}${imagenOg}`
    : undefined;

const OG_LOCALES: Record<Locale, string> = {
  es: 'es_ES',
  en: 'en_US',
  ca: 'ca_ES'
};

const hreflangs = LOCALES_DISPONIBLES.map(codigo => ({
  hreflang: codigo,
  href: `${siteUrl}${rutaConLocale(rutaActual, codigo)}`.replace(/\/$/, '') || `${siteUrl}/`
}));
const hrefDefault =
  `${siteUrl}${rutaConLocale(rutaActual, LOCALE_DEFECTO)}`.replace(/\/$/, '') || `${siteUrl}/`;
---

<!doctype html>
<html lang={lang} data-slug={SLUG_FARMACIA}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='generator' content={Astro.generator} />

    <link rel='preconnect' href='https://cdn.sanity.io' crossorigin />
    <link rel='preconnect' href='https://www.google.com' />
    <link rel='dns-prefetch' href='https://larokifarm-cima-chat-5f3.pages.dev' />

    <title>{titulo}</title>
    {descripcion && <meta name='description' content={descripcion} />}
    <link rel='canonical' href={canonical} />

    {hreflangs.map(h => <link rel='alternate' hreflang={h.hreflang} href={h.href} />)}
    <link rel='alternate' hreflang='x-default' href={hrefDefault} />

    <meta name='robots' content='index,follow,max-snippet:-1,max-image-preview:large' />

    <meta property='og:type' content='website' />
    <meta property='og:locale' content={OG_LOCALES[lang]} />
    {
      LOCALES_DISPONIBLES.filter(l => l !== lang).map(l => (
        <meta property='og:locale:alternate' content={OG_LOCALES[l]} />
      ))
    }
    <meta property='og:title' content={titulo} />
    {descripcion && <meta property='og:description' content={descripcion} />}
    <meta property='og:url' content={canonical} />
    {ogImageAbsoluta && <meta property='og:image' content={ogImageAbsoluta} />}

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={titulo} />
    {descripcion && <meta name='twitter:description' content={descripcion} />}
    {ogImageAbsoluta && <meta name='twitter:image' content={ogImageAbsoluta} />}

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='apple-touch-icon' href='/logo.png' />
    <link rel='manifest' href='/manifest.webmanifest' />
    <meta name='theme-color' content='#1265b5' />

    <link rel='preload' href={gilroyRegular} as='font' type='font/ttf' crossorigin />
    <link rel='preload' href={gilroyBlack} as='font' type='font/ttf' crossorigin />

    {
      jsonLd && (
        <script is:inline type='application/ld+json' set:html={JSON.stringify(jsonLd, null, 0)} />
      )
    }

    <slot name='head' />
  </head>
  <body>
    <a
      href='#contenido'
      class='sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-lg focus:bg-[var(--primary)] focus:px-4 focus:py-2 focus:font-semibold focus:text-white focus:shadow-lg focus:outline-2 focus:outline-offset-2 focus:outline-[var(--primary)]'
    >
      Saltar al contenido
    </a>
    <slot />

    <Analytics />
    <SpeedInsights />

    <script>
      // Tracking de conversiones (cookieless): clics en llamar y WhatsApp en toda la web.
      import { track } from '@vercel/analytics';

      document.addEventListener('click', e => {
        const enlace = (e.target as Element | null)?.closest('a');
        if (!enlace) return;
        const href = enlace.getAttribute('href') ?? '';
        if (href.startsWith('tel:')) track('llamar');
        else if (href.includes('wa.me') || href.includes('whatsapp')) track('whatsapp');
      });
    </script>

    <script>
      /* Motion global · IntersectionObserver único para [data-reveal] y [data-reveal-word]. */
      const observed = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-word]');
      if (observed.length > 0 && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('in-view');
              io.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });
        observed.forEach((el) => io.observe(el));
      } else {
        observed.forEach((el) => el.classList.add('in-view'));
      }

      /* Spotlight cursor tracking — solo en pointer:fine. */
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (finePointer) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
          el.classList.add('spotlight');
          el.addEventListener('pointermove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            el.style.setProperty('--mx', `${x}%`);
            el.style.setProperty('--my', `${y}%`);
          });
        });
      }

      /* Count-up animation · anima el número interior de 0 → N cuando el elemento
         entra en viewport. Usar data-count-up="N" en el elemento. */
      const counters = document.querySelectorAll<HTMLElement>('[data-count-up]');
      if (counters.length > 0 && 'IntersectionObserver' in window) {
        const preferSinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const cio = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            const target = parseFloat(el.dataset.countUp ?? '0');
            const duration = parseInt(el.dataset.countDuration ?? '1200', 10);
            const suffix = el.dataset.countSuffix ?? '';
            cio.unobserve(el);
            if (preferSinMovimiento) {
              el.textContent = `${target}${suffix}`;
              continue;
            }
            const start = performance.now();
            function tick(now: number) {
              const t = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - t, 3);
              const current = Math.round(target * eased);
              el.textContent = `${current}${suffix}`;
              if (t < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          }
        }, { threshold: 0.5 });
        counters.forEach((el) => cio.observe(el));
      }
    </script>

    <div
      data-cima-chat
      data-theme='light'
      data-primary-light='#1265b5'
      data-primary-dark='#ff6b9d'
      data-position='bottom-right'
    >
    </div>
    <script is:inline async src='https://larokifarm-cima-chat-5f3.pages.dev/cima-chat.iife.js'
    ></script>
  </body>
</html>
